# 判断一个软链是否"归属仓库"：把软链一路解析到最终真实路径，只要落在
# $SKILL_LIBRARY_ROOT/skills 之下（不管中间经过几层——直接指向仓库，或者
# 先指向 GLOBAL_SKILLS_DIR 再由它指向仓库），就认定是 skillctl 建立的托管
# 软链。不认识的外部软链一律跳过，不动。
eject_link_is_repo_managed() {
  local link="$1" real repo_real
  [ -L "$link" ] || return 1
  real="$(cd "$link" 2>/dev/null && pwd -P)" || return 1
  repo_real="$(real_dir "$SKILL_LIBRARY_ROOT/skills" 2>/dev/null || true)"
  [ -n "$repo_real" ] || return 1
  path_is_ancestor "$repo_real" "$real"
}

# 先对所有目标目录做一次只读扫描，把"哪些软链归属仓库、当前分别指向哪个
# 真实路径"整体记录进一个 dir;name;real 三列的计划文件，再统一执行。
# 不能一边扫描一边就地物化：如果先把 GLOBAL_SKILLS_DIR 下的软链换成了真实
# 拷贝，紧接着再扫描某个工具自己目录下"经过 GLOBAL_SKILLS_DIR 转一手"的
# 软链时，它已经不再解析到仓库（因为链路中间那一段已经是真实目录了），会
# 被误判成"不归属仓库"而被跳过——用一份预先固定的计划文件从根源上避免这
# 种"先处理的目标影响后处理的目标判断结果"的顺序依赖。
eject_build_plan() {
  local plan_file="$1" dir link name real
  shift
  : > "$plan_file"
  for dir in "$@"; do
    for link in "$dir"/*; do
      [ -L "$link" ] || continue
      eject_link_is_repo_managed "$link" || continue
      name="$(basename "$link")"
      real="$(cd "$link" && pwd -P)"
      printf '%s;%s;%s\n' "$dir" "$name" "$real" >> "$plan_file"
    done
  done
}

# 按计划文件里属于某个目录的记录逐条执行（或预演）：apply 模式下 ditto 到
# 暂存名，确认拷贝成功后才原地把软链换成真实目录（跟 import_copy_into_
# warehouse 一样，只在拷贝确认成功后才动原软链，避免中间态）。
eject_physicalize_planned() {
  local dir="$1" apply="$2" plan_file="$3"
  local p_dir p_name p_real link tmp_parent tmp failed=0 count=0
  while IFS=';' read -r p_dir p_name p_real; do
    [ "$p_dir" = "$dir" ] || continue
    count=$((count + 1))
    link="$dir/$p_name"
    if [ "$apply" != "yes" ]; then
      printf '  [预演] 物化 %s（复制自 %s）\n' "$link" "$p_real"
      continue
    fi
    tmp_parent="$(mktemp -d "$dir/.eject-XXXXXX" 2>/dev/null)" || {
      printf '  [失败] 无法创建暂存目录，跳过：%s\n' "$link" >&2
      failed=1
      continue
    }
    tmp="$tmp_parent/$p_name"
    if ! /usr/bin/ditto "$p_real" "$tmp"; then
      printf '  [失败] 复制失败，保留原软链：%s\n' "$link" >&2
      rm -rf "$tmp_parent"
      failed=1
      continue
    fi
    rm -f "$link"
    mv "$tmp" "$link"
    rmdir "$tmp_parent" 2>/dev/null || true
    printf '  [已物化] %s\n' "$link"
  done < "$plan_file"
  [ "$count" -eq 0 ] && printf '  没有受管软链\n'
  [ "$failed" -eq 0 ]
}

cmd_eject() {
  local apply="$1" adapters_file id display mode global_dir _project_dir cli_command app_name verification
  local resolved_dir safe_dir safe_global target backup_root backup_name idx failed=0 plan_file
  local plan_count plan_dir_count
  local -a targets=() target_labels=()

  safe_global="$(safe_link_directory "$GLOBAL_SKILLS_DIR" 2>/dev/null || true)"
  if [ -n "$safe_global" ] && [ -d "$safe_global" ] && [ ! -L "$safe_global" ]; then
    targets+=("$safe_global")
    target_labels+=("${GLOBAL_SKILLS_DIR}（全局共享目录，原生工具直接读取这里）")
  fi

  adapters_file="$(resolve_adapters_file)"
  if [ -f "$adapters_file" ]; then
    while IFS=';' read -r id display mode global_dir _project_dir cli_command app_name verification; do
      [ -n "$id" ] || continue
      case "$id" in \#*) continue ;; esac
      [ "$mode" = "link" ] || continue
      resolved_dir="$(expand_tilde "$global_dir")"
      safe_dir="$(safe_link_directory "$resolved_dir" 2>/dev/null || true)"
      [ -n "$safe_dir" ] && [ -d "$safe_dir" ] && [ ! -L "$safe_dir" ] || continue
      targets+=("$safe_dir")
      target_labels+=("${display}（${id}）")
    done < <(tr '\t' ';' < "$adapters_file")
  fi

  if [ "${#targets[@]}" -eq 0 ]; then
    printf '没有发现受管软链目录，无需 eject\n'
    return 0
  fi

  plan_file="$(mktemp "${TMPDIR:-/tmp}/skillctl-eject-plan.XXXXXX")" || {
    printf '无法创建临时计划文件，eject 中止\n' >&2
    return 1
  }
  trap 'rm -f "$plan_file"' RETURN
  eject_build_plan "$plan_file" "${targets[@]}"

  if [ ! -s "$plan_file" ]; then
    printf '没有发现受管软链目录，无需 eject\n'
    return 0
  fi

  plan_count="$(wc -l < "$plan_file" | tr -d ' ')"
  plan_dir_count="$(awk -F ';' '{print $1}' "$plan_file" | LC_ALL=C sort -u | wc -l | tr -d ' ')"

  if [ "$apply" != "yes" ]; then
    printf '[预演] eject 将把 %s 条受管软链物化为独立真实拷贝，涉及 %s 个目录：\n' "$plan_count" "$plan_dir_count"
    printf '备份位置（示意路径，实际时间戳以 --apply 执行时为准）：%s/eject-backups/<时间戳>/\n\n' "$SKILL_LIBRARY_ROOT"
    idx=0
    for target in "${targets[@]}"; do
      printf '── %s\n' "${target_labels[$idx]}"
      eject_physicalize_planned "$target" "no" "$plan_file"
      printf '\n'
      idx=$((idx + 1))
    done
    printf '确认后运行：skillctl eject --apply\n'
    return 0
  fi

  backup_root="$SKILL_LIBRARY_ROOT/eject-backups/$(date -u '+%Y%m%d-%H%M%S')"
  mkdir -p "$backup_root" || { printf '备份目录创建失败，eject 中止\n' >&2; return 1; }
  idx=0
  for target in "${targets[@]}"; do
    idx=$((idx + 1))
    backup_name="$idx-$(basename "$target")"
    if ! /usr/bin/ditto "$target" "$backup_root/$backup_name"; then
      printf '备份失败：%s，eject 中止（此前已生成的部分备份见 %s）\n' "$target" "$backup_root" >&2
      return 1
    fi
  done
  printf '已备份将改动的目录到: %s\n\n' "$backup_root"

  printf '开始物化 %s 条受管软链，涉及 %s 个目录：\n\n' "$plan_count" "$plan_dir_count"
  idx=0
  for target in "${targets[@]}"; do
    printf '── %s\n' "${target_labels[$idx]}"
    eject_physicalize_planned "$target" "yes" "$plan_file" || failed=1
    printf '\n'
    idx=$((idx + 1))
  done

  if [ "$failed" -eq 1 ]; then
    printf '部分目录物化失败，改动前的备份见 %s，请人工核查后重试\n' "$backup_root" >&2
    return 1
  fi

  printf '已脱离 skillctl 管理，各工具目录现为独立副本，仓库目录 %s 可自行保留或删除\n' "$SKILL_LIBRARY_ROOT"
}

doctor_report() {
  local level="$1" message="$2" fix="${3:-}"
  case "$level" in
    ok)
      DOCTOR_OK=$((DOCTOR_OK + 1))
      printf '✅ %s\n' "$message"
      ;;
    warn)
      DOCTOR_WARN=$((DOCTOR_WARN + 1))
      printf '⚠️ %s\n' "$message"
      [ -z "$fix" ] || printf '   → %s\n' "$fix"
      ;;
    fail)
      DOCTOR_FAIL=$((DOCTOR_FAIL + 1))
      printf '❌ %s\n' "$message"
      [ -z "$fix" ] || printf '   → %s\n' "$fix"
      ;;
  esac
}

doctor_check_global_broken_links() {
  local link id
  [ -d "$GLOBAL_SKILLS_DIR" ] && [ ! -L "$GLOBAL_SKILLS_DIR" ] || return 0
  for link in "$GLOBAL_SKILLS_DIR"/*; do
    [ -L "$link" ] || continue
    [ -e "$link" ] && continue
    id="$(basename "$link")"
    doctor_report fail "断链：$GLOBAL_SKILLS_DIR/$id 指向的仓库内容不存在" \
      "人工确认该 Skill 是否已被手动移出仓库；确认后 rm \"$GLOBAL_SKILLS_DIR/$id\" 清理，或把内容放回仓库后 skillctl activate $id --apply 重新建链"
  done
  return 0
}

doctor_check_tool_broken_links() {
  local adapters_file id display mode global_dir _project_dir cli_command app_name verification resolved_dir link name
  adapters_file="$(resolve_adapters_file)"
  [ -f "$adapters_file" ] || return 0
  while IFS=';' read -r id display mode global_dir _project_dir cli_command app_name verification; do
    [ -n "$id" ] || continue
    case "$id" in \#*) continue ;; esac
    [ "$mode" = "link" ] || continue
    resolved_dir="$(expand_tilde "$global_dir")"
    [ -d "$resolved_dir" ] && [ ! -L "$resolved_dir" ] || continue
    for link in "$resolved_dir"/*; do
      [ -L "$link" ] || continue
      [ -e "$link" ] && continue
      name="$(basename "$link")"
      doctor_report fail "断链：${display}（${id}）下的 $name 指向不存在的目标" \
        "skillctl tools connect $id --prune --apply"
    done
  done < <(tr '\t' ';' < "$adapters_file")
  return 0
}

# 用 DOCTOR_FAIL 计数器前后差值判断这一组检查是否发现了问题，不依赖子函数
# 的返回码——这个项目已经在 deactivate 分支上因为裸 `&&` 影响退出码踩过一次
# 坑（见 CLAUDE.md），这里改用计数器差值从根源上绕开同类风险。
doctor_check_broken_links() {
  local before
  before="$DOCTOR_FAIL"
  doctor_check_global_broken_links
  doctor_check_tool_broken_links
  if [ "$DOCTOR_FAIL" = "$before" ]; then
    doctor_report ok "没有发现断链"
  fi
}

# 断链检查（doctor_check_broken_links）是"货架上的软链指向仓库里已经不存在
# 的内容"；这里反过来查"货架上有真实目录（不是软链），仓库根本不认识"——
# 典型场景是直接让 AI 工具把新技能装到 ~/.agents/skills 或 ~/.claude/skills
# 这类原生扫描目录，而不是走 skillctl import，内容看似"装好了"，实际上
# 仓库和面板都不知道它存在。只查一层，不递归；只认"目录里有 SKILL.md"的
# 才算数，避免把货架下面的杂散文件/临时目录也报进来。
doctor_check_shelf_orphans_dir() {
  local dir="$1" entry id declared display
  [ -d "$dir" ] && [ ! -L "$dir" ] || return 0
  for entry in "$dir"/*; do
    [ -d "$entry" ] && [ ! -L "$entry" ] || continue
    [ -f "$entry/SKILL.md" ] || continue
    declared="$(skill_declared_name "$entry" 2>/dev/null || true)"
    id="$(basename "$entry")"
    if [ -n "$declared" ]; then
      [ -n "$(catalog_entry "$declared")" ] && continue
    else
      [ -n "$(catalog_entry "$id")" ] && continue
    fi
    display="${declared:-$id}"
    doctor_report warn "货架目录 $dir 下的 $display 是真实目录，不是仓库管理的软链，仓库和面板都不认识它" \
      "确认内容无误后 skillctl import \"$entry\" --activate --apply 收编进仓库"
  done
  return 0
}

doctor_check_shelf_orphans() {
  local before seen adapters_file id display mode global_dir _project_dir _cli_command _app_name _verification resolved_dir
  before="$DOCTOR_WARN"

  doctor_check_shelf_orphans_dir "$GLOBAL_SKILLS_DIR"
  seen=",$GLOBAL_SKILLS_DIR,"

  adapters_file="$(resolve_adapters_file)"
  if [ -f "$adapters_file" ]; then
    while IFS=';' read -r id display mode global_dir _project_dir _cli_command _app_name _verification; do
      [ -n "$id" ] || continue
      case "$id" in \#*) continue ;; esac
      [ "$mode" = "link" ] || continue
      resolved_dir="$(expand_tilde "$global_dir")"
      case "$seen" in *",$resolved_dir,"*) continue ;; esac
      seen="$seen$resolved_dir,"
      doctor_check_shelf_orphans_dir "$resolved_dir"
    done < <(tr '\t' ';' < "$adapters_file")
  fi

  [ "$DOCTOR_WARN" = "$before" ] && doctor_report ok "货架上没有发现未收编进仓库的真实目录"
  return 0
}

doctor_check_tools() {
  local adapters_file id display mode global_dir _project_dir cli_command app_name verification status resolved_dir keyword candidates
  adapters_file="$(resolve_adapters_file)"
  [ -f "$adapters_file" ] || {
    doctor_report fail "软件适配器配置不存在：$adapters_file" "检查安装是否完整（config/adapters/tools.tsv 缺失）"
    return 0
  }
  while IFS=';' read -r id display mode global_dir _project_dir cli_command app_name verification; do
    [ -n "$id" ] || continue
    case "$id" in \#*) continue ;; esac
    status="$(detect_status_for_row "$mode" "$global_dir" "$cli_command" "$app_name")"
    case "$status" in
      已检测)
        doctor_report ok "${display}（${id}）已检测到"
        ;;
      可能是残留目录)
        resolved_dir="$(expand_tilde "$global_dir")"
        doctor_report warn "${display}（${id}）只发现残留的软链目录 ${resolved_dir}，工具本身可能已卸载或未运行过" \
          "仍在用就先运行一次该工具；确认不再使用可以 skillctl tools disconnect $id --apply 清理"
        ;;
      未检测到)
        candidates=""
        keyword="${id%%-*}"
        if [ -n "$app_name" ] && [ -d "$APPLICATIONS_DIR" ]; then
          # candidates 只用来拼一行诊断文字给人看，不会再按行/按词拆开处理，
          # 应用文件夹名里出现换行这种边缘情况顶多让这行提示变丑，不影响正确性。
          # shellcheck disable=SC2010
          candidates="$(ls -1 "$APPLICATIONS_DIR" 2>/dev/null | grep -i -- "$keyword" || true)"
        fi
        if [ -n "$candidates" ]; then
          doctor_report warn "${display}（${id}）按配置的 app_name「${app_name}」未检测到，但 /Applications 下发现疑似同类文件夹：$(printf '%s' "$candidates" | tr '\n' '、')" \
            "确认这就是 $display 之后，手动把 tools.tsv 里 $id 这行的 app_name 改成真实文件夹名"
        else
          doctor_report warn "${display}（${id}）未检测到" \
            "先安装/运行一次该工具；如果确认已安装但显示名不同，用 ls /Applications | grep -i $keyword 核实后修正 tools.tsv 里的 app_name"
        fi
        ;;
    esac
  done < <(tr '\t' ';' < "$adapters_file")
}

doctor_check_verification() {
  local adapters_file id display mode global_dir _project_dir cli_command app_name verification found=0
  adapters_file="$(resolve_adapters_file)"
  [ -f "$adapters_file" ] || return 0
  while IFS=';' read -r id display mode global_dir _project_dir cli_command app_name verification; do
    [ -n "$id" ] || continue
    case "$id" in \#*) continue ;; esac
    if [ "$verification" = "unverified" ]; then
      found=1
      doctor_report warn "${display}（${id}）的 verification 字段字面为 unverified，tools connect 会被拦截" \
        "确认已完成人工核实后加 --allow-unverified 执行 tools connect $id"
    fi
  done < <(tr '\t' ';' < "$adapters_file")
  [ "$found" -eq 1 ] || doctor_report ok "verification：当前没有适配器被标记为 unverified（此项检查是为将来新增适配器保留的，目前基本不会触发）"
}

doctor_check_manual_list() {
  local ids id entry relative_path status link id2 profiles found=0
  ids="$(read_manual_ids)"
  if [ -n "$ids" ]; then
    while IFS= read -r id; do
      [ -n "$id" ] || continue
      entry="$(catalog_entry "$id")"
      if [ -z "$entry" ]; then
        found=1
        doctor_report warn "manual.list 记录了未登记的 Skill：$id" \
          "确认是否还需要，若不需要手动从 $SKILL_LIBRARY_ROOT/state/manual.list 删除该行"
        continue
      fi
      relative_path="${entry%%"$(printf '	')"*}"
      status="$(link_status "$GLOBAL_SKILLS_DIR/$id" "$relative_path")"
      if [ "$status" != "已激活" ]; then
        found=1
        doctor_report warn "manual.list 记录了 ${id}，但 $GLOBAL_SKILLS_DIR 下没有对应的受管软链（当前状态：${status:-缺失}）" \
          "如仍需要：skillctl activate $id --apply 重建；如不再需要：skillctl deactivate $id --apply 会一并清理 manual.list 记录"
      fi
    done <<< "$ids"
  fi

  if [ -d "$GLOBAL_SKILLS_DIR" ] && [ ! -L "$GLOBAL_SKILLS_DIR" ]; then
    for link in "$GLOBAL_SKILLS_DIR"/*; do
      [ -L "$link" ] && [ -e "$link" ] || continue
      # 只关心归属仓库的软链——用户自己手动指到仓库以外内容的软链（比如
      # 直接建到别的目录）不归 skillctl 管，不该被建议 activate/deactivate。
      eject_link_is_repo_managed "$link" || continue
      id2="$(basename "$link")"
      printf '%s\n' "$ids" | grep -F -x "$id2" >/dev/null 2>&1 && continue
      profiles="$(collect_profiles_for_id "$id2")"
      [ -n "$profiles" ] && continue
      found=1
      doctor_report warn "$id2 在 $GLOBAL_SKILLS_DIR 下有受管软链，但既不属于任何场景包，也没记录在 manual.list 里" \
        "如需保留：skillctl activate $id2 --apply 补登记进 manual.list；如不需要：skillctl deactivate $id2 --apply"
    done
  fi

  [ "$found" -eq 1 ] || doctor_report ok "manual.list 与磁盘软链状态一致"
}

doctor_check_skill_files() {
  local dir id name desc found=0
  [ -d "$SKILL_LIBRARY_ROOT/skills" ] || {
    doctor_report warn "仓库 skills/ 目录不存在：$SKILL_LIBRARY_ROOT/skills" "确认 SKILL_LIBRARY_ROOT 是否正确：$SKILL_LIBRARY_ROOT"
    return 0
  }
  for dir in "$SKILL_LIBRARY_ROOT/skills"/*; do
    [ -d "$dir" ] && [ ! -L "$dir" ] || continue
    id="$(basename "$dir")"
    case "$id" in .staging-*) continue ;; esac
    if [ ! -f "$dir/SKILL.md" ]; then
      found=1
      doctor_report fail "$id 缺少 SKILL.md" "补全 $dir/SKILL.md（需要 YAML frontmatter，含 name/description 字段）"
      continue
    fi
    name="$(skill_declared_name "$dir" 2>/dev/null || true)"
    desc="$(skill_description "$dir" 2>/dev/null || true)"
    if [ -z "$name" ]; then
      found=1
      doctor_report fail "$id 的 SKILL.md frontmatter 缺少合法 name 字段" "编辑 $dir/SKILL.md，在 frontmatter 里补上 name: $id"
    fi
    if [ -z "$desc" ]; then
      found=1
      doctor_report fail "$id 的 SKILL.md frontmatter 缺少 description 字段" "编辑 $dir/SKILL.md，在 frontmatter 里补上 description 字段"
    fi
  done
  [ "$found" -eq 1 ] || doctor_report ok "仓库内所有 Skill 的 SKILL.md frontmatter 都齐全（name/description）"
}

doctor_check_duplicate_ids() {
  local dupes id
  dupes="$(awk -F '\t' 'NF == 8 { print $1 }' "$CATALOG_FILE" | LC_ALL=C sort | uniq -d)"
  if [ -n "$dupes" ]; then
    while IFS= read -r id; do
      [ -n "$id" ] || continue
      doctor_report fail "catalog 中 id 重复：$id" \
        "检查是否有两个 Skill 目录的 SKILL.md 声明了相同的 name 字段，改成唯一值后重跑 build-catalog.sh --apply（或任意 import/archive/restore 会自动重建）"
    done <<< "$dupes"
  else
    doctor_report ok "catalog 中没有重复的 Skill id"
  fi
}

doctor_check_catalog_disk_consistency() {
  local found=0 id relative_path dir
  while IFS="$(printf '\t')" read -r id relative_path _display _aliases _category _triggers _excludes _description; do
    [ -n "$id" ] || continue
    if [ ! -d "$SKILL_LIBRARY_ROOT/$relative_path" ]; then
      found=1
      doctor_report fail "catalog 记录了 ${id}，但仓库目录不存在：$SKILL_LIBRARY_ROOT/$relative_path" \
        "运行 build-catalog.sh --apply 重建目录（或执行任意 import/archive/restore 会自动刷新）"
    fi
  done < "$CATALOG_FILE"

  if [ -d "$SKILL_LIBRARY_ROOT/skills" ]; then
    for dir in "$SKILL_LIBRARY_ROOT/skills"/*; do
      [ -d "$dir" ] && [ ! -L "$dir" ] || continue
      id="$(basename "$dir")"
      case "$id" in .staging-*) continue ;; esac
      if ! awk -F '\t' -v id="$id" 'NF == 8 && $1 == id { f = 1 } END { exit !f }' "$CATALOG_FILE"; then
        found=1
        doctor_report fail "仓库里有 ${id}，但 catalog 中没有记录" "运行 build-catalog.sh --apply 重建目录"
      fi
    done
  fi
  [ "$found" -eq 1 ] || doctor_report ok "catalog 与仓库磁盘内容一致"
}

cmd_doctor() {
  DOCTOR_OK=0
  DOCTOR_WARN=0
  DOCTOR_FAIL=0

  printf '== 软链健康检查 ==\n'
  doctor_check_broken_links

  printf '\n== 货架未收编内容 ==\n'
  doctor_check_shelf_orphans

  printf '\n== 工具检测 ==\n'
  doctor_check_tools

  printf '\n== verification 检查 ==\n'
  doctor_check_verification

  printf '\n== manual.list 一致性 ==\n'
  doctor_check_manual_list

  printf '\n== Skill 内容完整性 ==\n'
  doctor_check_skill_files

  printf '\n== catalog 重复 id ==\n'
  doctor_check_duplicate_ids

  printf '\n== catalog 与磁盘一致性 ==\n'
  doctor_check_catalog_disk_consistency

  printf '\n== 汇总 ==\n'
  printf '✅ %s  ⚠️ %s  ❌ %s\n' "$DOCTOR_OK" "$DOCTOR_WARN" "$DOCTOR_FAIL"
  [ "$DOCTOR_FAIL" -eq 0 ]
}

lint_report() {
  local level="$1" message="$2" fix="${3:-}"
  case "$level" in
    ok)
      LINT_OK=$((LINT_OK + 1))
      printf '✅ %s\n' "$message"
      ;;
    warn)
      LINT_WARN=$((LINT_WARN + 1))
      printf '⚠️ %s\n' "$message"
      [ -z "$fix" ] || printf '   → %s\n' "$fix"
      ;;
    fail)
      LINT_FAIL=$((LINT_FAIL + 1))
      printf '❌ %s\n' "$message"
      [ -z "$fix" ] || printf '   → %s\n' "$fix"
      ;;
  esac
}

# doctor 也检查 SKILL.md 是否存在、name/description 是否齐全（那是仓库
# 健康检查的一部分），lint 在此基础上多查一条 doctor 不管的：frontmatter
# 声明的 name 是否跟目录名一致——两者读同一份数据，各自独立判断，允许有
# 交集，不是谁包含谁。
lint_check_frontmatter() {
  local dir id declared_name desc found=0
  [ -d "$SKILL_LIBRARY_ROOT/skills" ] || {
    lint_report fail "仓库 skills/ 目录不存在：$SKILL_LIBRARY_ROOT/skills" "确认 SKILL_LIBRARY_ROOT 是否正确：$SKILL_LIBRARY_ROOT"
    return 0
  }
  for dir in "$SKILL_LIBRARY_ROOT/skills"/*; do
    [ -d "$dir" ] && [ ! -L "$dir" ] || continue
    id="$(basename "$dir")"
    case "$id" in .staging-*) continue ;; esac
    if [ ! -f "$dir/SKILL.md" ]; then
      found=1
      lint_report fail "$id 缺少 SKILL.md" "补全 $dir/SKILL.md（需要 YAML frontmatter，含 name/description 字段）"
      continue
    fi
    declared_name="$(skill_declared_name "$dir" 2>/dev/null || true)"
    desc="$(skill_description "$dir" 2>/dev/null || true)"
    if [ -z "$declared_name" ]; then
      found=1
      lint_report fail "$id 的 SKILL.md frontmatter 缺少合法 name 字段" "编辑 $dir/SKILL.md，补上 name: $id"
    elif [ "$declared_name" != "$id" ]; then
      found=1
      lint_report warn "$id 的 SKILL.md name 字段（${declared_name}）跟目录名不一致" "改 $dir/SKILL.md 的 name: 字段为 ${id}，或者重命名目录以保持一致"
    fi
    if [ -z "$desc" ]; then
      found=1
      lint_report fail "$id 的 SKILL.md frontmatter 缺少 description 字段" "编辑 $dir/SKILL.md，补上 description 字段"
    fi
  done
  [ "$found" -eq 1 ] || lint_report ok "仓库内所有 Skill 的 frontmatter 完整，且 name 字段与目录名一致"
}

# 阈值取自真实仓库数据的分布，用 bash 的 ${#desc}（真正参与比较的字符数）
# 量的，不是 awk length()（那个数的是字节数，中文按 UTF-8 三字节算，会把
# 阈值撑大三倍——校准时踩过这个坑）：87 个 Skill 实际是 18~802 字，中位数
# 193。下限 15 明显低于当前最短的 18（lark-attendance/debug-pro 这类范围
# 很窄的 Skill 天然就短，不该被当噪音报），上限 1000 明显高于当前最长的
# 802，两头都留了余量，不会在现有内容上报警，只在真正偏离的新增内容上生效。
lint_check_description_length() {
  local dir id desc len found=0
  [ -d "$SKILL_LIBRARY_ROOT/skills" ] || return 0
  for dir in "$SKILL_LIBRARY_ROOT/skills"/*; do
    [ -d "$dir" ] && [ ! -L "$dir" ] || continue
    id="$(basename "$dir")"
    case "$id" in .staging-*) continue ;; esac
    [ -f "$dir/SKILL.md" ] || continue
    desc="$(skill_description "$dir" 2>/dev/null || true)"
    [ -n "$desc" ] || continue
    len="${#desc}"
    if [ "$len" -lt 15 ]; then
      found=1
      lint_report warn "$id 的 description 只有 $len 字，信息量可能不够，容易被路由/搜索漏选" "补充触发场景和典型用户表达，参考仓库里其他 Skill 的写法"
    elif [ "$len" -gt 1000 ]; then
      found=1
      lint_report warn "$id 的 description 有 $len 字，偏长" "考虑精简，只保留核心触发场景描述"
    fi
  done
  [ "$found" -eq 1 ] || lint_report ok "所有 Skill 的 description 长度都在合理范围（15~1000 字）"
}

# 只在"当前激活集合"内部两两比较 triggers 列（catalog.tsv 第 6 列，逗号
# 分隔）——比较全部 87 个会对着完全不会同时出现在候选池里的 Skill 报噪音；
# 只比较真正会被同时看到的这批，才是路由歧义会不会实际发生的问题。
# O(n^2) 的两两比较放在一个 awk 进程里做，避免对 39 个 Skill 就要跑 700+
# 次子进程的开销。
lint_check_trigger_overlap() {
  local link id entry ids_file overlap_output found=0
  local -a active_ids=()

  if [ ! -d "$GLOBAL_SKILLS_DIR" ] || [ -L "$GLOBAL_SKILLS_DIR" ]; then
    lint_report ok "触发词重叠：当前没有激活的 Skill，跳过"
    return 0
  fi
  for link in "$GLOBAL_SKILLS_DIR"/*; do
    [ -L "$link" ] && [ -e "$link" ] || continue
    id="$(basename "$link")"
    entry="$(catalog_entry "$id")"
    [ -n "$entry" ] || continue
    active_ids+=("$id")
  done

  if [ "${#active_ids[@]}" -lt 2 ]; then
    lint_report ok "触发词重叠：激活的 Skill 不足两个，跳过"
    return 0
  fi

  ids_file="$(mktemp "${TMPDIR:-/tmp}/skillctl-lint-active.XXXXXX")" || {
    lint_report fail "无法创建临时文件，跳过触发词重叠检查" "重试，或检查 \$TMPDIR 是否可写"
    return 0
  }
  printf '%s\n' "${active_ids[@]}" > "$ids_file"

  overlap_output="$(awk -F '\t' -v ids_file="$ids_file" '
    BEGIN {
      while ((getline line < ids_file) > 0) {
        if (line != "") wanted[line] = 1
      }
      close(ids_file)
    }
    NF == 8 && ($1 in wanted) {
      order[++n] = $1
      triggers[$1] = $6
    }
    END {
      for (i = 1; i <= n; i++) {
        id_a = order[i]
        split(triggers[id_a], words_a, ",")
        delete set_a
        for (w = 1; w in words_a; w++) if (words_a[w] != "") set_a[words_a[w]] = 1
        for (j = i + 1; j <= n; j++) {
          id_b = order[j]
          split(triggers[id_b], words_b, ",")
          shared = ""
          shared_count = 0
          for (w = 1; w in words_b; w++) {
            if (words_b[w] != "" && (words_b[w] in set_a)) {
              shared_count++
              shared = (shared == "" ? words_b[w] : shared "," words_b[w])
            }
          }
          if (shared_count >= 2) print id_a "\t" id_b "\t" shared
        }
      }
    }
  ' "$CATALOG_FILE")"
  rm -f "$ids_file"

  if [ -n "$overlap_output" ]; then
    found=1
    while IFS="$(printf '\t')" read -r id_a id_b shared; do
      [ -n "$id_a" ] || continue
      lint_report warn "$id_a 和 $id_b 在当前激活集合内触发词重叠较多：$(printf '%s' "$shared" | tr ',' '、')" \
        "确认这两个 Skill 的边界是否清楚，必要时精简/差异化触发词"
    done <<< "$overlap_output"
  fi
  [ "$found" -eq 1 ] || lint_report ok "当前激活集合内没有明显的触发词重叠"
}

cmd_lint() {
  LINT_OK=0
  LINT_WARN=0
  LINT_FAIL=0

  printf '== frontmatter 完整性 ==\n'
  lint_check_frontmatter

  printf '\n== description 长度 ==\n'
  lint_check_description_length

  printf '\n== 激活集合内触发词重叠度 ==\n'
  lint_check_trigger_overlap

  printf '\n== 汇总 ==\n'
  printf '✅ %s  ⚠️ %s  ❌ %s\n' "$LINT_OK" "$LINT_WARN" "$LINT_FAIL"
  [ "$LINT_FAIL" -eq 0 ]
}

# 改变了激活/连接状态的 --apply 命令收尾时调用，让本地面板不至于长期是
# 陈旧快照。面板重建失败不应该让主命令本身报失败（激活/连接已经成功了），
# 所以这里只警告、不改变调用方的退出码。
auto_rebuild_dashboard() {
  if cmd_dashboard_build "yes" >/dev/null 2>&1; then
    printf '（已自动重建本地面板）\n'
  else
    printf '警告：自动重建面板失败，可手动运行 skillctl dashboard build --apply\n' >&2
  fi
}

# 出错时打印一句具体的下一步建议（而不是整段命令参考），再指向 skillctl
# help 看完整参考。每个命令自己的用法错误都在调用处给出针对该命令的提示。
usage_error() {
  printf '%s\n' "$1" >&2
  printf '完整命令参考：skillctl help\n' >&2
  exit 2
}

# 不带参数运行 skillctl 时的场景式速查——按"想做什么"而不是命令字母序组织，
# 控制在一屏以内（约 20 行），要看完整参数说明去查 usage()/skillctl help。
scene_help() {
  cat <<'EOF'
skillctl —— 多工具共用的 Skill 仓库管理

常用场景：
  skillctl status —— 看现状：每个 Skill 的激活/归档/冲突状态
  skillctl profile use <场景包名> --apply —— 切场景包（core/aipm/frameflow/stock/lark）
  skillctl activate <id> --apply —— 激活一个 Skill
  skillctl deactivate <id> --apply —— 停用一个 Skill
  skillctl import <绝对目录> --apply —— 把仓库外的 Skill 收进仓库
  skillctl archive <id> --apply —— 下架（软删除，能用 restore 恢复）
  skillctl tools detect —— 看哪些工具已装/已连接
  skillctl tools connect <工具id> --apply —— 把当前激活集合同步给某个工具
  skillctl doctor —— 体检：断链/工具检测/一致性等，只读
  skillctl lint —— 检查 Skill 内容质量：frontmatter/description 长度/触发词重叠，只读
  skillctl dashboard build --apply && skillctl dashboard open —— 生成并打开本地只读面板
  skillctl eject --apply —— 彻底退出这套软链管理（不可逆，先看预演）

其他：skillctl list ・ search <关键词> ・ restore <id> --apply
所有会改状态的命令都默认只预演，不带 --apply 不会真正执行；完整参数说明：skillctl help
EOF
}

# 完整命令参考，skillctl help/-h/--help 时展示；route/route-status/project
# 属于实验性功能（route 的自动选择还没达标启用，project 用得很少），行为和
# 参数完全不变，只是不出现在上面的场景速查里，也单独归了一类，别当成新增
# 功能去测——代码和既有测试没动。
usage() {
  cat <<'EOF'
skillctl —— 多工具共用的 Skill 仓库管理

只读查询：
  skillctl list
  skillctl search <关键词>
  skillctl status
  skillctl tools detect
  skillctl dashboard open
  skillctl doctor
  skillctl lint
  skillctl export <id> [--output <绝对路径>]        打包成干净拷贝，默认输出到 ~/Desktop/skill-export-<id>/

会改动状态的命令（默认只预演，加 --apply 才真正执行）：
  skillctl activate <id> [--apply]
  skillctl deactivate <id> [--apply]
  skillctl profile use <场景包名> [--apply]
  skillctl import <绝对目录> [--display-name 名称] [--alias 名称] [--activate] [--replace] [--apply]
  skillctl archive <id> [--apply]
  skillctl restore <id> [--archive-id 归档ID] [--reactivate] [--apply]
  skillctl tools connect <工具id> [--allow-unverified] [--prune] [--apply]
  skillctl tools disconnect <工具id> [--apply]
  skillctl dashboard build [--apply]
  skillctl eject [--apply]        彻底退出这套软链管理，不可逆

实验性（行为不变，代码保留，不进常用场景速查）：
  skillctl route <一句话描述>                      同 skillctl experimental route
  skillctl route-status                          同 skillctl experimental route-status
  skillctl project use <场景包名> <绝对项目路径> [--apply]   同 skillctl experimental project use ...

不带参数运行 skillctl 可以看场景式速查。
EOF
}

[ "$#" -gt 0 ] || {
  scene_help
  exit 0
}

command="$1"
shift
case "$command" in
  list)
    [ "$#" -eq 0 ] || usage_error "list 不接受参数；想按关键词筛选用 skillctl search <关键词>"
    require_catalog
    list_catalog
    ;;
  search)
    [ "$#" -gt 0 ] || usage_error "用法：skillctl search <关键词>，例如 skillctl search 飞书"
    require_catalog
    search_catalog "$*"
    ;;
  route|project|experimental)
    case "$command" in
      experimental)
        [ "$#" -ge 1 ] || usage_error "用法：skillctl experimental {route <文本>|route-status|project use <场景包名> <绝对项目路径> [--apply]}"
        exp_sub="$1"
        shift
        ;;
      route) exp_sub="route" ;;
      project) exp_sub="project" ;;
    esac
    case "$exp_sub" in
      route)
        [ "$#" -gt 0 ] || usage_error "用法：skillctl experimental route <一句话描述>，例如 skillctl experimental route \"帮我拆一下这个产品\""
        require_catalog
        route_candidates "$*"
        ;;
      route-status)
        [ "$#" -eq 0 ] || usage_error "route-status 不接受参数"
        require_catalog
        print_route_status
        ;;
      project)
        [ "$#" -eq 3 ] || [ "$#" -eq 4 ] || usage_error "用法：skillctl experimental project use <场景包名> <绝对项目路径> [--apply]"
        [ "$1" = "use" ] || usage_error "用法：skillctl experimental project use <场景包名> <绝对项目路径> [--apply]"
        profile_name="$2"
        project_path="$3"
        apply="no"
        if [ "$#" -eq 4 ]; then
          [ "$4" = "--apply" ] || usage_error "未知参数：$4；project use 只接受结尾的 --apply"
          apply="yes"
        fi
        require_catalog
        project_path="$(require_project_directory "$project_path")" || exit 2
        replace_profile_links "$project_path/.agents/skills" "$profile_name" "$apply"
        ;;
      *) usage_error "未知的 experimental 子命令：${exp_sub}；支持 route/route-status/project" ;;
    esac
    ;;
  status)
    [ "$#" -eq 0 ] || usage_error "status 不接受参数"
    require_catalog
    print_status
    ;;
  route-status)
    [ "$#" -eq 0 ] || usage_error "route-status 不接受参数"
    require_catalog
    print_route_status
    ;;
  activate)
    [ "$#" -eq 1 ] || [ "$#" -eq 2 ] || usage_error "用法：skillctl activate <id> [--apply]；不知道 id 就先 skillctl search <关键词> 确认"
    id="$1"
    apply="no"
    if [ "$#" -eq 2 ]; then
      [ "$2" = "--apply" ] || usage_error "未知参数：$2；activate 只接受结尾的 --apply"
      apply="yes"
    fi
    require_catalog
    APPLY_LINK_STATUS="skipped"
    apply_link_for_id "$GLOBAL_SKILLS_DIR" "$id" "$apply"
    if [ "$apply" = "yes" ] && [ "$APPLY_LINK_STATUS" = "managed" ]; then
      manual_list_add "$id"
      auto_rebuild_dashboard
    fi
    ;;
  deactivate)
    [ "$#" -eq 1 ] || [ "$#" -eq 2 ] || usage_error "用法：skillctl deactivate <id> [--apply]；不知道 id 就先 skillctl status 看当前激活了什么"
    id="$1"
    apply="no"
    if [ "$#" -eq 2 ]; then
      [ "$2" = "--apply" ] || usage_error "未知参数：$2；deactivate 只接受结尾的 --apply"
      apply="yes"
    fi
    require_catalog
    deactivate_id "$GLOBAL_SKILLS_DIR" "$id" "$apply"
    if [ "$apply" = "yes" ]; then
      manual_list_remove "$id"
      # 只在目标路径本身没有祖先软链这类安全隐患时才自动重建面板——那种
      # 情况下 deactivate_id 已经安全跳过、什么都没动，重建面板会凭空写出
      # 一个新文件，破坏"整棵树纹丝不动"这条既有安全测试断言的前提。
      if safe_link_directory "$GLOBAL_SKILLS_DIR" >/dev/null 2>&1; then
        auto_rebuild_dashboard
      fi
    fi
    ;;
  profile)
    [ "$#" -eq 2 ] || [ "$#" -eq 3 ] || usage_error "用法：skillctl profile use <场景包名> [--apply]；场景包名如 core/aipm/frameflow/stock/lark"
    [ "$1" = "use" ] || usage_error "用法：skillctl profile use <场景包名> [--apply]"
    profile_name="$2"
    apply="no"
    if [ "$#" -eq 3 ]; then
      [ "$3" = "--apply" ] || usage_error "未知参数：$3；profile use 只接受结尾的 --apply"
      apply="yes"
    fi
    require_catalog
    replace_profile_links "$GLOBAL_SKILLS_DIR" "$profile_name" "$apply"
    if [ "$apply" = "yes" ] && safe_link_directory "$GLOBAL_SKILLS_DIR" >/dev/null 2>&1; then
      auto_rebuild_dashboard
    fi
    ;;
  import)
    [ "$#" -ge 1 ] || usage_error "用法：skillctl import <绝对目录> [--display-name 名称] [--alias 名称] [--activate] [--replace] [--apply]"
    # 故意不在这里 require_catalog：import 是唯一允许在全新安装、
    # catalog.tsv 还不存在时运行的命令（它是"从零开始建仓库"的入口）。
    # cmd_import 自己不读 catalog.tsv，最后靠 rebuild_catalog_or_warn 把它
    # 建出来；真实发现：install-manager.sh --apply 之后、第一次 import 之前，
    # ~/.skill-library 下既没有 skills/ 也没有 catalog.tsv，这是刻意的
    # 设计边界（装机脚本从不碰这几个目录），import 得能在这个状态下跑通，
    # 不然干净账户走一遍 Quickstart 第一步就卡死。
    cmd_import "$@"
    ;;
  export)
    [ "$#" -eq 1 ] || [ "$#" -eq 3 ] || usage_error "用法：skillctl export <id> [--output <绝对路径>]；不知道 id 就先 skillctl status 或 skillctl search <关键词>"
    id="$1"
    output=""
    if [ "$#" -eq 3 ]; then
      [ "$2" = "--output" ] || usage_error "未知参数：$2；export 只接受 --output <绝对路径>"
      output="$3"
    fi
    require_catalog
    cmd_export "$id" "$output"
    ;;
  archive)
    [ "$#" -eq 1 ] || [ "$#" -eq 2 ] || usage_error "用法：skillctl archive <id> [--apply]；不知道 id 就先 skillctl status 看当前有哪些"
    id="$1"
    apply="no"
    if [ "$#" -eq 2 ]; then
      [ "$2" = "--apply" ] || usage_error "未知参数：$2；archive 只接受结尾的 --apply"
      apply="yes"
    fi
    require_catalog
    cmd_archive "$id" "$apply"
    ;;
  restore)
    [ "$#" -ge 1 ] || usage_error "用法：skillctl restore <id> [--archive-id 归档ID] [--reactivate] [--apply]"
    id="$1"
    shift
    restore_archive_id=""
    reactivate="no"
    apply="no"
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --archive-id)
          [ "$#" -ge 2 ] || usage_error "--archive-id 后面需要跟归档 ID（形如 20260814-124500-ab12cd34）"
          restore_archive_id="$2"
          shift 2
          ;;
        --reactivate) reactivate="yes"; shift ;;
        --apply) apply="yes"; shift ;;
        *) usage_error "未知参数：$1；restore 支持 --archive-id/--reactivate/--apply" ;;
      esac
    done
    require_catalog
    cmd_restore "$id" "$restore_archive_id" "$reactivate" "$apply"
    ;;
  tools)
    [ "$#" -ge 1 ] || usage_error "用法：skillctl tools {detect|connect <工具id> [--apply]|disconnect <工具id> [--apply]}"
    tools_sub="$1"
    shift
    case "$tools_sub" in
      detect)
        [ "$#" -eq 0 ] || usage_error "tools detect 不接受参数"
        cmd_tools_detect
        ;;
      connect)
        [ "$#" -ge 1 ] || usage_error "用法：skillctl tools connect <工具id> [--allow-unverified] [--prune] [--apply]；不知道工具 id 就先 skillctl tools detect"
        id="$1"
        shift
        apply="no"
        allow_unverified="no"
        prune="no"
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --apply) apply="yes"; shift ;;
            --allow-unverified) allow_unverified="yes"; shift ;;
            --prune) prune="yes"; shift ;;
            *) usage_error "未知参数：$1；tools connect 支持 --allow-unverified/--prune/--apply" ;;
          esac
        done
        cmd_tools_connect "$id" "$apply" "$allow_unverified" "$prune"
        if [ "$apply" = "yes" ]; then
          auto_rebuild_dashboard
        fi
        ;;
      disconnect)
        [ "$#" -eq 1 ] || [ "$#" -eq 2 ] || usage_error "用法：skillctl tools disconnect <工具id> [--apply]；不知道工具 id 就先 skillctl tools detect"
        id="$1"
        apply="no"
        if [ "$#" -eq 2 ]; then
          [ "$2" = "--apply" ] || usage_error "未知参数：$2；tools disconnect 只接受结尾的 --apply"
          apply="yes"
        fi
        cmd_tools_disconnect "$id" "$apply"
        if [ "$apply" = "yes" ]; then
          auto_rebuild_dashboard
        fi
        ;;
      *) usage_error "未知的 tools 子命令：${tools_sub}；支持 detect/connect/disconnect" ;;
    esac
    ;;
  dashboard)
    [ "$#" -ge 1 ] || usage_error "用法：skillctl dashboard {build [--apply]|open}"
    dashboard_sub="$1"
    shift
    case "$dashboard_sub" in
      build)
        [ "$#" -eq 0 ] || [ "$#" -eq 1 ] || usage_error "用法：skillctl dashboard build [--apply]"
        apply="no"
        if [ "$#" -eq 1 ]; then
          [ "$1" = "--apply" ] || usage_error "未知参数：$1；dashboard build 只接受结尾的 --apply"
          apply="yes"
        fi
        cmd_dashboard_build "$apply"
        ;;
      open)
        [ "$#" -eq 0 ] || usage_error "dashboard open 不接受参数"
        cmd_dashboard_open
        ;;
      *) usage_error "未知的 dashboard 子命令：${dashboard_sub}；支持 build/open" ;;
    esac
    ;;
  eject)
    [ "$#" -eq 0 ] || [ "$#" -eq 1 ] || usage_error "用法：skillctl eject [--apply]"
    apply="no"
    if [ "$#" -eq 1 ]; then
      [ "$1" = "--apply" ] || usage_error "未知参数：$1；eject 只接受结尾的 --apply"
      apply="yes"
    fi
    cmd_eject "$apply"
    if [ "$apply" = "yes" ]; then
      auto_rebuild_dashboard
    fi
    ;;
  doctor)
    [ "$#" -eq 0 ] || usage_error "doctor 不接受参数"
    require_catalog
    cmd_doctor
    ;;
  lint)
    [ "$#" -eq 0 ] || usage_error "lint 不接受参数"
    require_catalog
    cmd_lint
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage_error "未知命令：${command}；不带参数运行 skillctl 看常用场景，或 skillctl help 看完整命令"
    ;;
esac
