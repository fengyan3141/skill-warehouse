doctor_check_duplicate_ids() {
  local dupes id
  dupes="$(awk -F '\t' 'NF == 8 { print $1 }' "$CATALOG_FILE" | LC_ALL=C sort | uniq -d)"
  if [ -n "$dupes" ]; then
    while IFS= read -r id; do
      [ -n "$id" ] || continue
      doctor_report fail "catalog 中 id 重复：$id" \
        "检查是否有两个 Skill 目录的 SKILL.md 声明了相同的 name 字段，改成唯一值后重跑 build-catalog.sh --apply（或任意 import 会自动重建）"
    done <<< "$dupes"
  else
    doctor_report ok "catalog 中没有重复的 Skill id"
  fi
}

doctor_check_catalog_disk_consistency() {
  local found=0 id relative_path dir
  while IFS="$(printf '\t')" read -r id relative_path _display _aliases _category _triggers _excludes _description; do
    [ -n "$id" ] || continue
    if [ ! -d "$SKILL_LIBRARY_ROOT/$relative_path" ]; then
      found=1
      doctor_report fail "catalog 记录了 ${id}，但仓库目录不存在：$SKILL_LIBRARY_ROOT/$relative_path" \
        "运行 build-catalog.sh --apply 重建目录（或执行任意 import 会自动刷新）"
    fi
  done < "$CATALOG_FILE"

  if [ -d "$SKILL_LIBRARY_ROOT/skills" ]; then
    for dir in "$SKILL_LIBRARY_ROOT/skills"/*; do
      [ -d "$dir" ] && [ ! -L "$dir" ] || continue
      id="$(basename "$dir")"
      case "$id" in .staging-*) continue ;; esac
      if ! awk -F '\t' -v id="$id" 'NF == 8 && $1 == id { f = 1 } END { exit !f }' "$CATALOG_FILE"; then
        found=1
        doctor_report fail "仓库里有 ${id}，但 catalog 中没有记录" "运行 build-catalog.sh --apply 重建目录"
      fi
    done
  fi
  [ "$found" -eq 1 ] || doctor_report ok "catalog 与仓库磁盘内容一致"
}

cmd_doctor() {
  DOCTOR_OK=0
  DOCTOR_WARN=0
  DOCTOR_FAIL=0

  printf '== 软链健康检查 ==\n'
  doctor_check_broken_links

  printf '\n== 货架未收编内容 ==\n'
  doctor_check_shelf_orphans

  printf '\n== 工具检测 ==\n'
  doctor_check_tools

  printf '\n== verification 检查 ==\n'
  doctor_check_verification

  printf '\n== manual.list 一致性 ==\n'
  doctor_check_manual_list

  printf '\n== Skill 内容完整性 ==\n'
  doctor_check_skill_files

  printf '\n== catalog 重复 id ==\n'
  doctor_check_duplicate_ids

  printf '\n== catalog 与磁盘一致性 ==\n'
  doctor_check_catalog_disk_consistency

  printf '\n== 汇总 ==\n'
  printf '✅ %s  ⚠️ %s  ❌ %s\n' "$DOCTOR_OK" "$DOCTOR_WARN" "$DOCTOR_FAIL"
  [ "$DOCTOR_FAIL" -eq 0 ]
}

lint_report() {
  local level="$1" message="$2" fix="${3:-}"
  case "$level" in
    ok)
      LINT_OK=$((LINT_OK + 1))
      printf '✅ %s\n' "$message"
      ;;
    warn)
      LINT_WARN=$((LINT_WARN + 1))
      printf '⚠️ %s\n' "$message"
      [ -z "$fix" ] || printf '   → %s\n' "$fix"
      ;;
    fail)
      LINT_FAIL=$((LINT_FAIL + 1))
      printf '❌ %s\n' "$message"
      [ -z "$fix" ] || printf '   → %s\n' "$fix"
      ;;
  esac
}

# doctor 也检查 SKILL.md 是否存在、name/description 是否齐全（那是仓库
# 健康检查的一部分），lint 在此基础上多查一条 doctor 不管的：frontmatter
# 声明的 name 是否跟目录名一致——两者读同一份数据，各自独立判断，允许有
# 交集，不是谁包含谁。
lint_check_frontmatter() {
  local dir id declared_name desc found=0
  [ -d "$SKILL_LIBRARY_ROOT/skills" ] || {
    lint_report fail "仓库 skills/ 目录不存在：$SKILL_LIBRARY_ROOT/skills" "确认 SKILL_LIBRARY_ROOT 是否正确：$SKILL_LIBRARY_ROOT"
    return 0
  }
  for dir in "$SKILL_LIBRARY_ROOT/skills"/*; do
    [ -d "$dir" ] && [ ! -L "$dir" ] || continue
    id="$(basename "$dir")"
    case "$id" in .staging-*) continue ;; esac
    if [ ! -f "$dir/SKILL.md" ]; then
      found=1
      lint_report fail "$id 缺少 SKILL.md" "补全 $dir/SKILL.md（需要 YAML frontmatter，含 name/description 字段）"
      continue
    fi
    declared_name="$(skill_declared_name "$dir" 2>/dev/null || true)"
    desc="$(skill_description "$dir" 2>/dev/null || true)"
    if [ -z "$declared_name" ]; then
      found=1
      lint_report fail "$id 的 SKILL.md frontmatter 缺少合法 name 字段" "编辑 $dir/SKILL.md，补上 name: $id"
    elif [ "$declared_name" != "$id" ]; then
      found=1
      lint_report warn "$id 的 SKILL.md name 字段（${declared_name}）跟目录名不一致" "改 $dir/SKILL.md 的 name: 字段为 ${id}，或者重命名目录以保持一致"
    fi
    if [ -z "$desc" ]; then
      found=1
      lint_report fail "$id 的 SKILL.md frontmatter 缺少 description 字段" "编辑 $dir/SKILL.md，补上 description 字段"
    fi
  done
  [ "$found" -eq 1 ] || lint_report ok "仓库内所有 Skill 的 frontmatter 完整，且 name 字段与目录名一致"
}

# 数 UTF-8 字符数，不能用 bash 的 ${#desc}——那只在 bash 4+ 且当前 locale
# 是 UTF-8 时才按字符数，系统自带的 /bin/bash（3.2，这个项目实际运行的
# 版本）不认 locale，永远按字节数数，中文会被数成 3 倍（曾经当真按
# ${#desc} 校准过阈值，结果在 3.2 下把字节数当字符数报，数字全错，
# work/run_skill_library_tests.sh 里 test_lint_flags_too_long_description
# 那条断言测出来的）。也不能用 awk 的 length()——不管 locale 是什么，
# macOS 自带 awk 一样按字节数数，跟 ${#desc} 是同一个坑。
# 唯一可靠的办法：总字节数减去 UTF-8 续字节数（0x80-0xFF 里的
# 0x80-0xBF 那一段）——续字节不是新字符的起始字节，减掉之后剩下的就是
# 真正的字符数，全程只按字节匹配，不依赖任何 locale 数据是否装在这台机
# 器上。跟 clone_github_repo 里 `LC_ALL=C tr -d '\000-\037\177-\377'`
# 是同一个"强制按字节处理"的思路。
# 阈值取自真实仓库数据的分布：87 个 Skill 实际是 18~802 字，中位数 193。
# 下限 15 明显低于当前最短的 18（lark-attendance/debug-pro 这类范围
# 很窄的 Skill 天然就短，不该被当噪音报），上限 1000 明显高于当前最长的
# 802，两头都留了余量，不会在现有内容上报警，只在真正偏离的新增内容上生效。
utf8_char_count() {
  local s="$1" byte_count cont_bytes
  byte_count="$(printf '%s' "$s" | LC_ALL=C wc -c | tr -d ' ')"
  cont_bytes="$(printf '%s' "$s" | LC_ALL=C tr -d '\000-\177\300-\377' | LC_ALL=C wc -c | tr -d ' ')"
  printf '%s' "$((byte_count - cont_bytes))"
}

lint_check_description_length() {
  local dir id desc len found=0
  [ -d "$SKILL_LIBRARY_ROOT/skills" ] || return 0
  for dir in "$SKILL_LIBRARY_ROOT/skills"/*; do
    [ -d "$dir" ] && [ ! -L "$dir" ] || continue
    id="$(basename "$dir")"
    case "$id" in .staging-*) continue ;; esac
    [ -f "$dir/SKILL.md" ] || continue
    desc="$(skill_description "$dir" 2>/dev/null || true)"
    [ -n "$desc" ] || continue
    len="$(utf8_char_count "$desc")"
    if [ "$len" -lt 15 ]; then
      found=1
      lint_report warn "$id 的 description 只有 $len 字，信息量可能不够，容易被路由/搜索漏选" "补充触发场景和典型用户表达，参考仓库里其他 Skill 的写法"
    elif [ "$len" -gt 1000 ]; then
      found=1
      lint_report warn "$id 的 description 有 $len 字，偏长" "考虑精简，只保留核心触发场景描述"
    fi
  done
  [ "$found" -eq 1 ] || lint_report ok "所有 Skill 的 description 长度都在合理范围（15~1000 字）"
}

# 只在"当前激活集合"内部两两比较 triggers 列（catalog.tsv 第 6 列，逗号
# 分隔）——比较全部 87 个会对着完全不会同时出现在候选池里的 Skill 报噪音；
# 只比较真正会被同时看到的这批，才是路由歧义会不会实际发生的问题。
# O(n^2) 的两两比较放在一个 awk 进程里做，避免对 39 个 Skill 就要跑 700+
# 次子进程的开销。
lint_check_trigger_overlap() {
  local link id entry ids_file overlap_output found=0
  local -a active_ids=()

  if [ ! -d "$GLOBAL_SKILLS_DIR" ] || [ -L "$GLOBAL_SKILLS_DIR" ]; then
    lint_report ok "触发词重叠：当前没有激活的 Skill，跳过"
    return 0
  fi
  for link in "$GLOBAL_SKILLS_DIR"/*; do
    [ -L "$link" ] && [ -e "$link" ] || continue
    id="$(basename "$link")"
    entry="$(catalog_entry "$id")"
    [ -n "$entry" ] || continue
    active_ids+=("$id")
  done

  if [ "${#active_ids[@]}" -lt 2 ]; then
    lint_report ok "触发词重叠：激活的 Skill 不足两个，跳过"
    return 0
  fi

  ids_file="$(mktemp "${TMPDIR:-/tmp}/skillctl-lint-active.XXXXXX")" || {
    lint_report fail "无法创建临时文件，跳过触发词重叠检查" "重试，或检查 \$TMPDIR 是否可写"
    return 0
  }
  printf '%s\n' "${active_ids[@]}" > "$ids_file"

  overlap_output="$(awk -F '\t' -v ids_file="$ids_file" '
    BEGIN {
      while ((getline line < ids_file) > 0) {
        if (line != "") wanted[line] = 1
      }
      close(ids_file)
    }
    NF == 8 && ($1 in wanted) {
      order[++n] = $1
      triggers[$1] = $6
    }
    END {
      for (i = 1; i <= n; i++) {
        id_a = order[i]
        split(triggers[id_a], words_a, ",")
        delete set_a
        for (w = 1; w in words_a; w++) if (words_a[w] != "") set_a[words_a[w]] = 1
        for (j = i + 1; j <= n; j++) {
          id_b = order[j]
          split(triggers[id_b], words_b, ",")
          shared = ""
          shared_count = 0
          for (w = 1; w in words_b; w++) {
            if (words_b[w] != "" && (words_b[w] in set_a)) {
              shared_count++
              shared = (shared == "" ? words_b[w] : shared "," words_b[w])
            }
          }
          if (shared_count >= 2) print id_a "\t" id_b "\t" shared
        }
      }
    }
  ' "$CATALOG_FILE")"
  rm -f "$ids_file"

  if [ -n "$overlap_output" ]; then
    found=1
    while IFS="$(printf '\t')" read -r id_a id_b shared; do
      [ -n "$id_a" ] || continue
      lint_report warn "$id_a 和 $id_b 在当前激活集合内触发词重叠较多：$(printf '%s' "$shared" | tr ',' '、')" \
        "确认这两个 Skill 的边界是否清楚，必要时精简/差异化触发词"
    done <<< "$overlap_output"
  fi
  [ "$found" -eq 1 ] || lint_report ok "当前激活集合内没有明显的触发词重叠"
}

cmd_lint() {
  LINT_OK=0
  LINT_WARN=0
  LINT_FAIL=0

  printf '== frontmatter 完整性 ==\n'
  lint_check_frontmatter

  printf '\n== description 长度 ==\n'
  lint_check_description_length

  printf '\n== 激活集合内触发词重叠度 ==\n'
  lint_check_trigger_overlap

  printf '\n== 汇总 ==\n'
  printf '✅ %s  ⚠️ %s  ❌ %s\n' "$LINT_OK" "$LINT_WARN" "$LINT_FAIL"
  [ "$LINT_FAIL" -eq 0 ]
}

# ---------------------------------------------------------------------------
# backup —— 把仓库真身 push/pull 到一个私有 GitHub 仓库，供换机器时恢复。
# 只管 SKILL_LIBRARY_ROOT 这一份数据仓库，跟 skillctl 工具本身（bin/lib，
# 将来要开源的那份代码）完全独立——数据仓库必须私有，两者不能混进同一个仓库。
# ---------------------------------------------------------------------------

BACKUP_DEFAULT_REPO_NAME="skill-library-backup"

backup_write_gitignore() {
  cat > "$SKILL_LIBRARY_ROOT/.gitignore" <<'EOF'
# skillctl backup 自动生成——机器本地产物，不进版本控制。
.DS_Store
**/.DS_Store
**/__pycache__/
**/*.pyc
**/.venv/
**/node_modules/
eject-backups/
# backup init 把 Skill 自带的内层 .git 重命名成 .git.bak（避免被当成断链
# submodule）——这条规则保证它们不会被当成普通文件提交进备份，不能指望
# 每个 Skill 自己的 .gitignore 里凑巧有条 *.bak 之类的规则罩住它。
skills/*/.git.bak/
# 面板整个目录都是构建产物，换机器后用 skillctl dashboard build --apply
# 重新生成——不能只写 dashboard/index.html：生成过程会先 mktemp 一个
# dashboard/.index.html.XXXXXX 再原子替换成最终文件，只忽略最终文件名的
# 话，这个过程中的隐藏临时文件会被 git status 当成一项未提交的改动。
dashboard/
EOF
}

# 收编进仓库的 Skill 如果自带独立 .git（比如 import-github 时连着克隆下来
# 的），git add 会把它当成断链的 submodule（gitlink），目录内容实际上不会
# 被追踪进备份——必须先处理掉这些内层 .git。
backup_find_nested_git_dirs() {
  [ -d "$SKILL_LIBRARY_ROOT/skills" ] || return 0
  find "$SKILL_LIBRARY_ROOT/skills" -mindepth 2 -maxdepth 2 -name '.git' -type d 2>/dev/null
}

cmd_backup_init() {
  local apply="$1" remote_url="$2" repo_name="${3:-$BACKUP_DEFAULT_REPO_NAME}"

  if [ -d "$SKILL_LIBRARY_ROOT/.git" ]; then
    printf '%s 已经是 Git 仓库，无需再次 init；看现状用 skillctl backup status，提交同步用 skillctl backup sync\n' "$SKILL_LIBRARY_ROOT" >&2
    return 1
  fi

  if [ -n "$remote_url" ]; then
    if [ -d "$SKILL_LIBRARY_ROOT" ] && [ -n "$(ls -A "$SKILL_LIBRARY_ROOT" 2>/dev/null)" ]; then
      printf '%s 已经有内容，为避免覆盖不会自动 clone 到这里。\n' "$SKILL_LIBRARY_ROOT" >&2
      printf '确认要用远端备份覆盖本机的话，先手动挪走/清空这个目录，再重新运行这条命令。\n' >&2
      return 1
    fi
    if [ "$apply" != "yes" ]; then
      printf '[预演] 从备份恢复：\n'
      printf '  git clone %s %s\n' "$remote_url" "$SKILL_LIBRARY_ROOT"
      printf '\n确认后运行：skillctl backup init --remote %s --apply\n' "$remote_url"
      return 0
    fi
    mkdir -p "$(dirname "$SKILL_LIBRARY_ROOT")"
    git clone "$remote_url" "$SKILL_LIBRARY_ROOT"
    printf '\n恢复完成，接下来：\n'
    printf '  skillctl doctor                          —— 看哪些 Skill 还没在这台机器摊开\n'
    printf '  skillctl profile use <场景包名> --apply   —— 或用 activate 逐个摊开\n'
    printf '  skillctl tools connect <工具id> --apply   —— link 模式工具要额外建软链\n'
    return 0
  fi

  local -a nested_git=()
  while IFS= read -r nested_dir; do nested_git+=("$nested_dir"); done < <(backup_find_nested_git_dirs)

  if [ "$apply" != "yes" ]; then
    printf '[预演] skillctl backup init 将执行：\n'
    printf '  1. git init（%s）\n' "$SKILL_LIBRARY_ROOT"
    printf '  2. 写入 .gitignore（排除 .venv/__pycache__/node_modules/.DS_Store/dashboard 构建产物/eject 备份）\n'
    if [ "${#nested_git[@]}" -gt 0 ]; then
      printf '  3. 发现 %s 个 Skill 自带独立 .git，会重命名成 .git.bak（不删除，避免父仓库把它们当成断链 submodule、内容进不去备份）：\n' "${#nested_git[@]}"
      local nested_dir
      for nested_dir in "${nested_git[@]}"; do printf '     - %s\n' "${nested_dir%/.git}"; done
    fi
    printf '  4. git add -A && git commit -m "skillctl backup: 初始快照"\n'
    printf '  5. gh repo create %s --private --source=. --remote=origin --push\n' "$repo_name"
    printf '\n需要先 gh auth login 登录 GitHub；确认后运行：skillctl backup init --apply\n'
    return 0
  fi

  command -v gh >/dev/null 2>&1 || { printf 'gh 命令不存在，先装 GitHub CLI 再试：https://cli.github.com/\n' >&2; return 1; }
  gh auth status >/dev/null 2>&1 || { printf 'gh 还没登录，先运行：gh auth login\n' >&2; return 1; }

  local nested_dir
  for nested_dir in "${nested_git[@]}"; do
    mv "$nested_dir" "${nested_dir}.bak"
    printf '已重命名（保留历史，不进这个新仓库）：%s -> %s.bak\n' "$nested_dir" "$nested_dir"
  done

  backup_write_gitignore

  (
    cd "$SKILL_LIBRARY_ROOT"
    git init -q
    git add -A
    git commit -q -m "skillctl backup: 初始快照"
    gh repo create "$repo_name" --private --source=. --remote=origin --push
  )
  printf '\n备份仓库已创建并推送（私有）：%s\n往后改动用 skillctl backup sync [--apply] 提交同步。\n' "$repo_name"
}

cmd_backup_status() {
  if [ ! -d "$SKILL_LIBRARY_ROOT/.git" ]; then
    printf '%s 还不是 Git 仓库；运行 skillctl backup init 看设置步骤\n' "$SKILL_LIBRARY_ROOT"
    return 0
  fi
  (
    cd "$SKILL_LIBRARY_ROOT"
    local branch remote dirty last ahead_behind ahead behind nested
    branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || printf '?')"
    remote="$(git remote get-url origin 2>/dev/null || printf '（未设置）')"
    printf '仓库：%s\n分支：%s\n远端：%s\n' "$SKILL_LIBRARY_ROOT" "$branch" "$remote"

    dirty="$(git status --porcelain | wc -l | tr -d ' ')"
    printf '未提交改动：%s 项\n' "$dirty"

    if git remote get-url origin >/dev/null 2>&1; then
      git fetch -q origin "$branch" 2>/dev/null || true
      ahead_behind="$(git rev-list --left-right --count "origin/${branch}...${branch}" 2>/dev/null || printf '')"
      if [ -n "$ahead_behind" ]; then
        behind="$(printf '%s' "$ahead_behind" | awk '{print $1}')"
        ahead="$(printf '%s' "$ahead_behind" | awk '{print $2}')"
        printf '领先远端：%s 个提交　落后远端：%s 个提交\n' "$ahead" "$behind"
      fi
    fi

    last="$(git log -1 --format='%ci' 2>/dev/null || printf '（还没有提交）')"
    printf '最近一次提交：%s\n' "$last"

    nested="$(backup_find_nested_git_dirs)"
    [ -z "$nested" ] || printf '⚠️ 发现未处理的内嵌 .git（会被当成断链 submodule，内容进不去备份）：\n%s\n' "$nested"
  )
}

cmd_backup_sync() {
  local apply="$1"
  [ -d "$SKILL_LIBRARY_ROOT/.git" ] || { printf '%s 还不是 Git 仓库，先运行 skillctl backup init\n' "$SKILL_LIBRARY_ROOT" >&2; return 1; }

  (
    cd "$SKILL_LIBRARY_ROOT"
    local branch changed
    branch="$(git rev-parse --abbrev-ref HEAD)"
    git remote get-url origin >/dev/null 2>&1 || { printf '还没配置远端 origin，先运行 skillctl backup init\n' >&2; exit 1; }

    if [ "$apply" != "yes" ]; then
      printf '[预演] skillctl backup sync 将执行：\n'
      changed="$(git status --porcelain)"
      if [ -n "$changed" ]; then
        printf '  1. 提交本地改动：\n'
        printf '%s\n' "$changed" | sed 's/^/     /'
      else
        printf '  1. 本地无未提交改动\n'
      fi
      printf '  2. git fetch origin %s，远端有新提交就合并\n' "$branch"
      printf '  3. 合并干净就 push；同一个 Skill 目录本地和远端都改过的话，会在这一步停下，按 Skill 整目录列出冲突，不自动帮你选\n'
      printf '\n确认后运行：skillctl backup sync --apply\n'
      exit 0
    fi

    git add -A
    if ! git diff --cached --quiet; then
      git commit -q -m "skillctl backup: $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    fi

    git fetch -q origin "$branch"

    if git merge -q --no-edit "origin/$branch"; then
      git push -q origin "$branch"
      printf '同步完成，已推送到远端\n'
      # 同步拉进来的改动可能包含"另一台机器删掉了某个 Skill"——git 只管
      # 仓库内部（skills/、catalog.tsv），不知道、也管不到这台机器自己的
      # ~/.agents/skills 或各工具目录里那些指回仓库的软链，被删掉的 Skill
      # 如果在本机是激活状态，同步完就会留下一个断链，deactivate 也清不
      # 掉（找不到对应的仓库记录，会直接跳过）。之前只能等用户自己想起来
      # 跑一次 doctor 才会发现；这里复用 doctor 同一套检查，同步完顺手扫
      # 一遍，有断链才出声，没有就安静过去，不重复 doctor 里"没有发现
      # 断链"这句正常场景的噪音。
      DOCTOR_FAIL=0
      doctor_check_global_broken_links
      doctor_check_tool_broken_links
      if [ "$DOCTOR_FAIL" -gt 0 ]; then
        printf '\n⚠️ 上面这 %s 个断链，是同步带来的改动导致的（很可能是别的机器把对应 Skill 删了，这台机器还激活着）。按各自后面给的命令清理，或者内容还在的话 skillctl activate <id> --apply 重新收回来。\n' "$DOCTOR_FAIL"
      fi
    else
      printf '⚠️ 远端和本地都改过同一批内容，自动合并停在这里，没有推送。冲突涉及：\n\n'
      git diff --name-only --diff-filter=U | while IFS= read -r conflict_file; do
        case "$conflict_file" in
          skills/*/*) printf '%s\n' "${conflict_file#skills/}" | cut -d/ -f1 ;;
          *) printf '%s\n' "$conflict_file" ;;
        esac
      done | LC_ALL=C sort -u | sed 's/^/  · /'
      printf '\n按整个目录二选一处理（不是逐行改，在 %s 目录下执行）：\n' "$SKILL_LIBRARY_ROOT"
      printf '  保留本机版本：git checkout --ours -- skills/<id> && git add skills/<id>\n'
      printf '  保留远端版本：git checkout --theirs -- skills/<id> && git add skills/<id>\n'
      printf '  两个都留：先把本机那份挪到 skills/<id>-local，再 git checkout --theirs -- skills/<id> && git add -A\n'
      printf '\n处理完运行：git commit && skillctl backup sync --apply（补上 push）\n'
      exit 1
    fi
  )
}

# 删除 = 停用（清共享货架软链）+ 仓库真身挪废纸篓（可反悔）+ catalog 重建
# + aliases.tsv 里这行记录一起清掉。之前这四步分散在两处、还各自漏了最
# 后一步：dashboard-server.py 的 /action delete 分支直接在 Python 里做前
# 三步，静态模式复制的命令只有前两步（deactivate + osascript），两条路径
# 都没人管 aliases.tsv。收成这一个命令后，两条路径都改成调用它，不再各
# 写一遍、各漏一遍。
cmd_delete() {
  local id="$1" apply="$2"
  local entry rel_path skill_dir

  entry="$(catalog_entry "$id")"
  if [ -z "$entry" ]; then
    printf '仓库里没有这个 id：%s；不知道 id 就先 skillctl status 或 skillctl search <关键词>\n' "$id" >&2
    return 1
  fi
  rel_path="${entry%%"$(printf '\t')"*}"
  skill_dir="$SKILL_LIBRARY_ROOT/$rel_path"

  if [ "$apply" != "yes" ]; then
    printf '[预演] skillctl delete %s 将执行：\n' "$id"
    printf '  1. 停用（清掉共享货架软链，未激活则无害跳过；link 模式工具自己的软链要另外 tools connect 才会刷新）\n'
    printf '  2. 把 %s 挪进系统废纸篓（不是永久删除）\n' "$skill_dir"
    printf '  3. 重建 catalog.tsv，清掉 config/aliases.tsv 里这个 id 的记录\n'
    printf '\n确认后运行：skillctl delete %s --apply\n' "$id"
    return 0
  fi

  deactivate_id "$GLOBAL_SKILLS_DIR" "$id" "yes"
  manual_list_remove "$id"

  if [ -e "$skill_dir" ]; then
    trash_path "$skill_dir"
  fi

  rebuild_catalog_or_warn
  remove_alias_row "$(resolve_aliases_file)" "$id"
  auto_rebuild_dashboard
  printf '已删除：%s（在系统废纸篓可恢复）\n' "$id"
}

# 改变了激活/连接状态的 --apply 命令收尾时调用，让本地面板不至于长期是
# 陈旧快照。面板重建失败不应该让主命令本身报失败（激活/连接已经成功了），
# 所以这里只警告、不改变调用方的退出码。
auto_rebuild_dashboard() {
  if cmd_dashboard_build "yes" >/dev/null 2>&1; then
    printf '（已自动重建本地面板）\n'
  else
    printf '警告：自动重建面板失败，可手动运行 skillctl dashboard build --apply\n' >&2
  fi
}

# 出错时打印一句具体的下一步建议（而不是整段命令参考），再指向 skillctl
# help 看完整参考。每个命令自己的用法错误都在调用处给出针对该命令的提示。
usage_error() {
  printf '%s\n' "$1" >&2
  printf '完整命令参考：skillctl help\n' >&2
  exit 2
}

# 不带参数运行 skillctl 时的场景式速查——按"想做什么"而不是命令字母序组织，
# 控制在一屏以内（约 20 行），要看完整参数说明去查 usage()/skillctl help。
scene_help() {
  cat <<'EOF'
skillctl —— 多工具共用的 Skill 仓库管理

常用场景：
  skillctl status —— 看现状：每个 Skill 的激活/冲突状态
  skillctl profile use <场景包名> --apply —— 切场景包（core 永远保留，其余看 config/profiles/ 下有哪些）
  skillctl activate <id> --apply —— 激活一个 Skill
  skillctl deactivate <id> --apply —— 停用一个 Skill
  skillctl import <绝对目录> --apply —— 把仓库外的 Skill 收进仓库
  skillctl import-github <GitHub URL> --apply —— 从 GitHub 仓库直接导入（多 Skill 仓库配 --path 子路径）
  skillctl check-updates [id] —— 看登记过来源的 Skill 有没有上游更新，只读
  skillctl tools detect —— 看哪些工具已装/已连接
  skillctl tools connect <工具id> --apply —— 把当前激活集合同步给某个工具
  skillctl doctor —— 体检：断链/工具检测/一致性等，只读
  skillctl lint —— 检查 Skill 内容质量：frontmatter/description 长度/触发词重叠，只读
  skillctl dashboard serve —— 起本地服务打开面板，按钮点击直接生效（激活/停用/删除/同步备份）
  skillctl backup init/sync --apply —— 换机器备份：建私有 GitHub 仓库、提交推送改动，不带子命令看用法
  skillctl eject --apply —— 彻底退出这套软链管理（不可逆，先看预演）

其他：skillctl list ・ search <关键词>
所有会改状态的命令都默认只预演，不带 --apply 不会真正执行；完整参数说明：skillctl help
EOF
}

# 完整命令参考，skillctl help/-h/--help 时展示；route/route-status/project
# 属于实验性功能（route 的自动选择还没达标启用，project 用得很少），行为和
# 参数完全不变，只是不出现在上面的场景速查里，也单独归了一类，别当成新增
# 功能去测——代码和既有测试没动。
usage() {
  cat <<'EOF'
skillctl —— 多工具共用的 Skill 仓库管理

只读查询：
  skillctl list
  skillctl search <关键词>
  skillctl status
  skillctl tools detect
  skillctl dashboard open
  skillctl backup status
  skillctl doctor
  skillctl lint
  skillctl export <id> [--output <绝对路径>]        打包成干净拷贝，默认输出到 ~/Desktop/skill-export-<id>/
  skillctl check-updates [id]        不给 id 就检查所有登记过来源的；本地内容跟登记时不一致（说明手动改过）的会跳过，不联网比对

会改动状态的命令（默认只预演，加 --apply 才真正执行）：
  skillctl activate <id> [--apply]
  skillctl deactivate <id> [--apply]
  skillctl profile use <场景包名> [--apply]
  skillctl import <绝对目录> [--display-name 名称] [--alias 名称] [--activate] [--replace] [--apply]
  skillctl import-github <GitHub URL> [--path 子路径] [--ref 分支/tag] [--display-name 名称] [--alias 名称] [--activate] [--replace] [--apply]
  skillctl track-source <id> <GitHub URL> [--path 子路径] [--ref 分支/tag] [--apply]        给已有 Skill 补登记来源（基准版本 = 登记那一刻的当前内容）
  skillctl tools connect <工具id> [--allow-unverified] [--prune] [--apply]
  skillctl tools add <平台名称> <技能目录路径> [--apply]
  skillctl tools disconnect <工具id> [--apply]
  skillctl dashboard build [--apply]
  skillctl dashboard serve         起本地服务，面板上的操作按钮直接生效
  skillctl backup init [--remote <GitHub仓库地址>] [--repo-name 名称] [--apply]     不给 --remote 是全新建私仓；新机器恢复用 --remote
  skillctl backup sync [--apply]        提交本地改动、拉取远端；冲突按 Skill 整目录列出，不逐行合并
  skillctl delete <id> [--apply]        停用 + 挪进系统废纸篓 + 清理 catalog.tsv/config/aliases.tsv 记录
  skillctl eject [--apply]        彻底退出这套软链管理，不可逆

实验性（行为不变，代码保留，不进常用场景速查）：
  skillctl route <一句话描述>                      同 skillctl experimental route
  skillctl route-status                          同 skillctl experimental route-status
  skillctl project use <场景包名> <绝对项目路径> [--apply]   同 skillctl experimental project use ...

不带参数运行 skillctl 可以看场景式速查。
EOF
}

[ "$#" -gt 0 ] || {
  scene_help
  exit 0
}

command="$1"
shift
case "$command" in
  list)
    [ "$#" -eq 0 ] || usage_error "list 不接受参数；想按关键词筛选用 skillctl search <关键词>"
    require_catalog
    list_catalog
    ;;
  search)
    [ "$#" -gt 0 ] || usage_error "用法：skillctl search <关键词>，例如 skillctl search 飞书"
    require_catalog
    search_catalog "$*"
    ;;
  route|project|experimental)
    case "$command" in
      experimental)
        [ "$#" -ge 1 ] || usage_error "用法：skillctl experimental {route <文本>|route-status|project use <场景包名> <绝对项目路径> [--apply]}"
        exp_sub="$1"
        shift
        ;;
      route) exp_sub="route" ;;
      project) exp_sub="project" ;;
    esac
    case "$exp_sub" in
      route)
        [ "$#" -gt 0 ] || usage_error "用法：skillctl experimental route <一句话描述>，例如 skillctl experimental route \"帮我拆一下这个产品\""
        require_catalog
        route_candidates "$*"
        ;;
      route-status)
        [ "$#" -eq 0 ] || usage_error "route-status 不接受参数"
        require_catalog
        print_route_status
        ;;
      project)
        [ "$#" -eq 3 ] || [ "$#" -eq 4 ] || usage_error "用法：skillctl experimental project use <场景包名> <绝对项目路径> [--apply]"
        [ "$1" = "use" ] || usage_error "用法：skillctl experimental project use <场景包名> <绝对项目路径> [--apply]"
        profile_name="$2"
        project_path="$3"
        apply="no"
        if [ "$#" -eq 4 ]; then
          [ "$4" = "--apply" ] || usage_error "未知参数：$4；project use 只接受结尾的 --apply"
          apply="yes"
        fi
        require_catalog
        project_path="$(require_project_directory "$project_path")" || exit 2
        replace_profile_links "$project_path/.agents/skills" "$profile_name" "$apply"
        ;;
      *) usage_error "未知的 experimental 子命令：${exp_sub}；支持 route/route-status/project" ;;
    esac
    ;;
  status)
    [ "$#" -eq 0 ] || usage_error "status 不接受参数"
    require_catalog
    print_status
    ;;
  route-status)
    [ "$#" -eq 0 ] || usage_error "route-status 不接受参数"
    require_catalog
    print_route_status
    ;;
  activate)
    [ "$#" -eq 1 ] || [ "$#" -eq 2 ] || usage_error "用法：skillctl activate <id> [--apply]；不知道 id 就先 skillctl search <关键词> 确认"
    id="$1"
    apply="no"
    if [ "$#" -eq 2 ]; then
      [ "$2" = "--apply" ] || usage_error "未知参数：$2；activate 只接受结尾的 --apply"
      apply="yes"
    fi
    require_catalog
    APPLY_LINK_STATUS="skipped"
    apply_link_for_id "$GLOBAL_SKILLS_DIR" "$id" "$apply"
    if [ "$apply" = "yes" ] && [ "$APPLY_LINK_STATUS" = "managed" ]; then
      manual_list_add "$id"
      auto_rebuild_dashboard
    fi
    ;;
  deactivate)
    [ "$#" -eq 1 ] || [ "$#" -eq 2 ] || usage_error "用法：skillctl deactivate <id> [--apply]；不知道 id 就先 skillctl status 看当前激活了什么"
    id="$1"
    apply="no"
    if [ "$#" -eq 2 ]; then
      [ "$2" = "--apply" ] || usage_error "未知参数：$2；deactivate 只接受结尾的 --apply"
      apply="yes"
    fi
    require_catalog
    deactivate_id "$GLOBAL_SKILLS_DIR" "$id" "$apply"
    if [ "$apply" = "yes" ]; then
      manual_list_remove "$id"
      # 只在目标路径本身没有祖先软链这类安全隐患时才自动重建面板——那种
      # 情况下 deactivate_id 已经安全跳过、什么都没动，重建面板会凭空写出
      # 一个新文件，破坏"整棵树纹丝不动"这条既有安全测试断言的前提。
      if safe_link_directory "$GLOBAL_SKILLS_DIR" >/dev/null 2>&1; then
        auto_rebuild_dashboard
      fi
    fi
    ;;
  profile)
    [ "$#" -eq 2 ] || [ "$#" -eq 3 ] || usage_error "用法：skillctl profile use <场景包名> [--apply]；场景包名看 config/profiles/ 目录下有哪些文件"
    [ "$1" = "use" ] || usage_error "用法：skillctl profile use <场景包名> [--apply]"
    profile_name="$2"
    apply="no"
    if [ "$#" -eq 3 ]; then
      [ "$3" = "--apply" ] || usage_error "未知参数：$3；profile use 只接受结尾的 --apply"
      apply="yes"
    fi
    require_catalog
    replace_profile_links "$GLOBAL_SKILLS_DIR" "$profile_name" "$apply"
    if [ "$apply" = "yes" ] && safe_link_directory "$GLOBAL_SKILLS_DIR" >/dev/null 2>&1; then
      auto_rebuild_dashboard
    fi
    ;;
  import)
    [ "$#" -ge 1 ] || usage_error "用法：skillctl import <绝对目录> [--display-name 名称] [--alias 名称] [--activate] [--replace] [--apply]"
    # 故意不在这里 require_catalog：import 是唯一允许在全新安装、
    # catalog.tsv 还不存在时运行的命令（它是"从零开始建仓库"的入口）。
    # cmd_import 自己不读 catalog.tsv，最后靠 rebuild_catalog_or_warn 把它
    # 建出来；真实发现：install-manager.sh --apply 之后、第一次 import 之前，
    # ~/.skill-library 下既没有 skills/ 也没有 catalog.tsv，这是刻意的
    # 设计边界（装机脚本从不碰这几个目录），import 得能在这个状态下跑通，
    # 不然干净账户走一遍 Quickstart 第一步就卡死。
    cmd_import "$@"
    ;;
  import-github)
    [ "$#" -ge 1 ] || usage_error "用法：skillctl import-github <GitHub URL> [--path 子路径] [--ref 分支/tag] [--display-name 名称] [--alias 名称] [--activate] [--replace] [--apply]"
    # 跟 import 一样，故意不在这里 require_catalog：cmd_import_github 最终
    # 会落到 cmd_import，同样得能在全新安装、catalog.tsv 还不存在时跑通。
    cmd_import_github "$@"
    ;;
  track-source)
    [ "$#" -ge 2 ] || usage_error "用法：skillctl track-source <id> <GitHub URL> [--path 子路径] [--ref 分支/tag] [--apply]"
    id="$1"
    url="$2"
    shift 2
    track_path=""
    track_ref=""
    apply="no"
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --path)
          [ "$#" -ge 2 ] || usage_error "--path 后面需要跟子路径"
          track_path="$2"
          shift 2
          ;;
        --ref)
          [ "$#" -ge 2 ] || usage_error "--ref 后面需要跟分支或 tag"
          track_ref="$2"
          shift 2
          ;;
        --apply) apply="yes"; shift ;;
        *) usage_error "未知参数：$1；track-source 支持 --path/--ref/--apply" ;;
      esac
    done
    require_catalog
    cmd_track_source "$id" "$url" "$track_path" "$track_ref" "$apply"
    ;;
  check-updates)
    [ "$#" -eq 0 ] || [ "$#" -eq 1 ] || usage_error "用法：skillctl check-updates [id]"
    require_catalog
    cmd_check_updates "${1:-}"
    ;;
  export)
    [ "$#" -eq 1 ] || [ "$#" -eq 3 ] || usage_error "用法：skillctl export <id> [--output <绝对路径>]；不知道 id 就先 skillctl status 或 skillctl search <关键词>"
    id="$1"
    output=""
    if [ "$#" -eq 3 ]; then
      [ "$2" = "--output" ] || usage_error "未知参数：$2；export 只接受 --output <绝对路径>"
      output="$3"
    fi
    require_catalog
    cmd_export "$id" "$output"
    ;;
  tools)
    [ "$#" -ge 1 ] || usage_error "用法：skillctl tools {detect|connect <工具id> [--apply]|disconnect <工具id> [--apply]|add <平台名称> <技能目录路径> [--apply]}"
    tools_sub="$1"
    shift
    case "$tools_sub" in
      add)
        [ "$#" -eq 2 ] || [ "$#" -eq 3 ] || usage_error "用法：skillctl tools add <平台名称> <技能目录路径> [--apply]"
        tool_name="$1"
        tool_dir="$2"
        apply="no"
        if [ "$#" -eq 3 ]; then
          [ "$3" = "--apply" ] || usage_error "未知参数：$3；tools add 只接受结尾的 --apply"
          apply="yes"
        fi
        cmd_add_custom_tool "$tool_name" "$tool_dir" "$apply"
        if [ "$apply" = "yes" ]; then
          auto_rebuild_dashboard
        fi
        ;;
      detect)
        [ "$#" -eq 0 ] || usage_error "tools detect 不接受参数"
        cmd_tools_detect
        ;;
      connect)
        [ "$#" -ge 1 ] || usage_error "用法：skillctl tools connect <工具id> [--allow-unverified] [--prune] [--apply]；不知道工具 id 就先 skillctl tools detect"
        id="$1"
        shift
        apply="no"
        allow_unverified="no"
        prune="no"
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --apply) apply="yes"; shift ;;
            --allow-unverified) allow_unverified="yes"; shift ;;
            --prune) prune="yes"; shift ;;
            *) usage_error "未知参数：$1；tools connect 支持 --allow-unverified/--prune/--apply" ;;
          esac
        done
        cmd_tools_connect "$id" "$apply" "$allow_unverified" "$prune"
        if [ "$apply" = "yes" ]; then
          auto_rebuild_dashboard
        fi
        ;;
      disconnect)
        [ "$#" -eq 1 ] || [ "$#" -eq 2 ] || usage_error "用法：skillctl tools disconnect <工具id> [--apply]；不知道工具 id 就先 skillctl tools detect"
        id="$1"
        apply="no"
        if [ "$#" -eq 2 ]; then
          [ "$2" = "--apply" ] || usage_error "未知参数：$2；tools disconnect 只接受结尾的 --apply"
          apply="yes"
        fi
        cmd_tools_disconnect "$id" "$apply"
        if [ "$apply" = "yes" ]; then
          auto_rebuild_dashboard
        fi
        ;;
      *) usage_error "未知的 tools 子命令：${tools_sub}；支持 detect/connect/disconnect/add" ;;
    esac
    ;;
  dashboard)
    [ "$#" -ge 1 ] || usage_error "用法：skillctl dashboard {build [--apply]|open|serve}"
    dashboard_sub="$1"
    shift
    case "$dashboard_sub" in
      build)
        [ "$#" -eq 0 ] || [ "$#" -eq 1 ] || usage_error "用法：skillctl dashboard build [--apply]"
        apply="no"
        if [ "$#" -eq 1 ]; then
          [ "$1" = "--apply" ] || usage_error "未知参数：$1；dashboard build 只接受结尾的 --apply"
          apply="yes"
        fi
        cmd_dashboard_build "$apply"
        ;;
      open)
        [ "$#" -eq 0 ] || usage_error "dashboard open 不接受参数"
        cmd_dashboard_open
        ;;
      serve)
        [ "$#" -eq 0 ] || usage_error "dashboard serve 不接受参数"
        cmd_dashboard_serve
        ;;
      *) usage_error "未知的 dashboard 子命令：${dashboard_sub}；支持 build/open/serve" ;;
    esac
    ;;
  delete)
    [ "$#" -eq 1 ] || [ "$#" -eq 2 ] || usage_error "用法：skillctl delete <id> [--apply]；不知道 id 就先 skillctl status 或 skillctl search <关键词>"
    id="$1"
    apply="no"
    if [ "$#" -eq 2 ]; then
      [ "$2" = "--apply" ] || usage_error "未知参数：$2；delete 只接受结尾的 --apply"
      apply="yes"
    fi
    require_catalog
    cmd_delete "$id" "$apply"
    ;;
  backup)
    [ "$#" -ge 1 ] || usage_error "用法：skillctl backup {init [--remote <GitHub仓库地址>] [--repo-name 名称] [--apply]|status|sync [--apply]}"
    backup_sub="$1"
    shift
    case "$backup_sub" in
      init)
        remote_url=""
        repo_name=""
        apply="no"
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --remote)
              [ "$#" -ge 2 ] || usage_error "--remote 后面需要跟 GitHub 仓库地址"
              remote_url="$2"
              shift 2
              ;;
            --repo-name)
              [ "$#" -ge 2 ] || usage_error "--repo-name 后面需要跟仓库名"
              repo_name="$2"
              shift 2
              ;;
            --apply) apply="yes"; shift ;;
            *) usage_error "未知参数：$1；backup init 支持 --remote/--repo-name/--apply" ;;
          esac
        done
        cmd_backup_init "$apply" "$remote_url" "$repo_name"
        ;;
      status)
        [ "$#" -eq 0 ] || usage_error "backup status 不接受参数"
        cmd_backup_status
        ;;
      sync)
        [ "$#" -eq 0 ] || [ "$#" -eq 1 ] || usage_error "用法：skillctl backup sync [--apply]"
        apply="no"
        if [ "$#" -eq 1 ]; then
          [ "$1" = "--apply" ] || usage_error "未知参数：$1；backup sync 只接受结尾的 --apply"
          apply="yes"
        fi
        cmd_backup_sync "$apply"
        ;;
      *) usage_error "未知的 backup 子命令：${backup_sub}；支持 init/status/sync" ;;
    esac
    ;;
  eject)
    [ "$#" -eq 0 ] || [ "$#" -eq 1 ] || usage_error "用法：skillctl eject [--apply]"
    apply="no"
    if [ "$#" -eq 1 ]; then
      [ "$1" = "--apply" ] || usage_error "未知参数：$1；eject 只接受结尾的 --apply"
      apply="yes"
    fi
    cmd_eject "$apply"
    if [ "$apply" = "yes" ]; then
      auto_rebuild_dashboard
    fi
    ;;
  doctor)
    [ "$#" -eq 0 ] || usage_error "doctor 不接受参数"
    require_catalog
    cmd_doctor
    ;;
  lint)
    [ "$#" -eq 0 ] || usage_error "lint 不接受参数"
    require_catalog
    cmd_lint
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage_error "未知命令：${command}；不带参数运行 skillctl 看常用场景，或 skillctl help 看完整命令"
    ;;
esac
