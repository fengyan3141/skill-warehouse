cmd_dashboard_open() {
  local html="$SKILL_LIBRARY_ROOT/dashboard/index.html"
  [ -f "$html" ] || { printf '面板尚未生成，请先运行 skillctl dashboard build --apply\n' >&2; return 1; }
  open "$html"
