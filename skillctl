#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
# Dev package layout has lib/ and config/ as siblings of this script; the
# installed layout (Task 10) puts this script in bin/ with lib/ and config/
# one level up as siblings of bin/. Detect which one we're in.
if [ -d "$SCRIPT_DIR/lib" ] && [ -d "$SCRIPT_DIR/config" ]; then
  PACKAGE_ROOT="$SCRIPT_DIR"
else
  PACKAGE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
fi
SKILL_LIBRARY_ROOT="${SKILL_LIBRARY_ROOT:-$HOME/.skill-library}"
CATALOG_FILE="$SKILL_LIBRARY_ROOT/catalog.tsv"
GLOBAL_SKILLS_DIR="${SKILLS_ACTIVE:-${SKILL_GLOBAL_DIR:-$HOME/.agents/skills}}"
PROJECT_SKILLS_DIR="${SKILL_PROJECT_DIR:-$(pwd -P)/.agents/skills}"
PROFILE_DIR="$PACKAGE_ROOT/config/profiles"
SKILL_LIB="$PACKAGE_ROOT/lib/skill-lib.sh"
APPLICATIONS_DIR="${SKILL_APPLICATIONS_DIR:-/Applications}"

[ -f "$SKILL_LIB" ] || {
  printf '共享函数不存在: %s\n' "$SKILL_LIB" >&2
  exit 1
}
# shellcheck source=lib/skill-lib.sh
. "$SKILL_LIB"

require_catalog() {
  if [ ! -f "$CATALOG_FILE" ]; then
    printf '目录不存在: %s\n' "$CATALOG_FILE" >&2
    return 1
  fi
}

catalog_entry() {
  local id="$1"
  awk -F '\t' -v id="$id" 'NF == 8 && $1 == id { print $2 "\t" $3; exit }' "$CATALOG_FILE"
}

physical_skill_target() {
  local relative_path="$1"
  real_dir "$SKILL_LIBRARY_ROOT/$relative_path"
}

relative_link_target() {
  local from_dir="$1" target_dir="$2"
  awk -v from="$from_dir" -v target="$target_dir" '
    BEGIN {
      count_from = split(from, from_parts, "/")
      count_target = split(target, target_parts, "/")
      position = 1
      while (position <= count_from && position <= count_target && from_parts[position] == target_parts[position]) position++
      result = ""
      for (part = position; part <= count_from; part++) result = result (result == "" ? ".." : "/..")
      for (part = position; part <= count_target; part++) result = result (result == "" ? target_parts[part] : "/" target_parts[part])
      print (result == "" ? "." : result)
    }
  '
}

safe_link_directory() {
  local directory="$1" ancestor suffix="" component physical inspected
  case "$directory" in
    /*) ;;
    *) return 1 ;;
  esac

  inspected="$directory"
  while :; do
    [ ! -L "$inspected" ] || return 1
    [ "$inspected" = "/" ] && break
    inspected="$(dirname "$inspected")"
  done

  ancestor="$directory"
  while [ ! -e "$ancestor" ] && [ ! -L "$ancestor" ]; do
    component="$(basename "$ancestor")"
    suffix="/$component$suffix"
    ancestor="$(dirname "$ancestor")"
  done
  [ ! -L "$ancestor" ] || return 1
  physical="$(real_dir "$ancestor")" || return 1
  printf '%s%s\n' "$physical" "$suffix"
}

managed_link_matches() {
  local link="$1" expected="$2" standard_target="$3" current raw_target
  [ -L "$link" ] || return 1
  raw_target="$(managed_link_target "$link")" || return 1
  [ "$raw_target" = "$standard_target" ] || return 1
  current="$(cd "$link" 2>/dev/null && pwd -P)" || return 1
  [ "$current" = "$expected" ]
}

link_conflict_status() {
  local link="$1" expected="$2" standard_target="$3"
  if [ -L "$link" ]; then
    if managed_link_matches "$link" "$expected" "$standard_target"; then
      printf 'managed\n'
    else
      printf '外部软链冲突\n'
    fi
  elif [ -e "$link" ]; then
    printf '真实目录冲突\n'
  else
    printf 'missing\n'
  fi
}

display_for_id() {
  local id="$1" entry
  entry="$(catalog_entry "$id")"
  [ -n "$entry" ] || return 1
  printf '%s\n' "${entry#*"$(printf '	')"}"
}

# 出口状态写进全局变量 APPLY_LINK_STATUS（managed / skipped），供调用方判断
# 这次调用是否真的建立/确认了受管软链——不能靠调用方事后自己拿 [ -L ... ]
# 去猜，猜会被"路径中间有祖先软链，凑巧落在别的软链上"这种情况骗过去。
apply_link_for_id() {
  local destination_dir="$1" id="$2" apply="$3" entry relative_path display target link status relative_target safe_destination
  APPLY_LINK_STATUS="skipped"
  valid_skill_name "$id" || {
    printf '[跳过] 非法 Skill ID %s\n' "$id"
    return 0
  }
  entry="$(catalog_entry "$id")"
  [ -n "$entry" ] || {
    printf '[跳过] 未登记 Skill %s\n' "$id"
    return 0
  }
  relative_path="${entry%%"$(printf '	')"*}"
  display="${entry#*"$(printf '	')"}"
  target="$(physical_skill_target "$relative_path" 2>/dev/null || true)"
  [ -n "$target" ] || {
    printf '[跳过] 仓库缺少 %s\n' "$id"
    return 0
  }
  safe_destination="$(safe_link_directory "$destination_dir" 2>/dev/null || true)"
  [ -n "$safe_destination" ] || {
    printf '[跳过] 目标路径含软链 %s\n' "$destination_dir"
    return 0
  }
  link="$safe_destination/$id"
  relative_target="$(relative_link_target "$safe_destination" "$target")"
  status="$(link_conflict_status "$link" "$target" "$relative_target")"
  case "$status" in
    managed)
      APPLY_LINK_STATUS="managed"
      printf '[已激活] %s -> %s\n' "$display" "$link"
      return 0
      ;;
    真实目录冲突|外部软链冲突)
      printf '[跳过] %s %s（不改动）\n' "$status" "$id"
      printf '  想收编进仓库：skillctl import %s --apply\n' "$link"
      printf '  想保留原样：无需操作，skillctl 不会管理此目录\n'
      return 0
      ;;
  esac
  if [ "$apply" = "yes" ]; then
    mkdir -p "$safe_destination"
    ln -s "$relative_target" "$link"
    APPLY_LINK_STATUS="managed"
    printf '[已激活] %s -> %s\n' "$display" "$link"
  else
    printf '[预演] 激活 %s -> %s\n' "$display" "$link"
  fi
}

deactivate_id() {
  local destination_dir="$1" id="$2" apply="$3" entry relative_path target link status safe_destination relative_target
  valid_skill_name "$id" || {
    printf '[跳过] 非法 Skill ID %s\n' "$id"
    return 0
  }
  entry="$(catalog_entry "$id")"
  [ -n "$entry" ] || {
    printf '[跳过] 未登记 Skill %s\n' "$id"
    return 0
  }
  relative_path="${entry%%"$(printf '	')"*}"
  target="$(physical_skill_target "$relative_path" 2>/dev/null || true)"
  [ -n "$target" ] || {
    printf '[跳过] 仓库缺少 %s\n' "$id"
    return 0
  }
  safe_destination="$(safe_link_directory "$destination_dir" 2>/dev/null || true)"
  [ -n "$safe_destination" ] || {
    printf '[跳过] 目标路径含软链 %s\n' "$destination_dir"
    return 0
  }
  link="$safe_destination/$id"
  relative_target="$(relative_link_target "$safe_destination" "$target")"
  status="$(link_conflict_status "$link" "$target" "$relative_target")"
  case "$status" in
    managed)
      if [ "$apply" = "yes" ]; then
        rm "$link"
        printf '[已停用] %s\n' "$id"
      else
        printf '[预演] 停用 %s\n' "$id"
      fi
      ;;
    missing)
      printf '[已停用] %s\n' "$id"
      ;;
    *)
      printf '[跳过] %s %s：该软链/目录非本工具托管，未改动\n' "$status" "$id"
      ;;
  esac
}

# 手动激活列表：记录通过 `activate <id> --apply` 单独激活（不经由场景包）的
# skill id，一行一个。profile_ids() 把它并进目标集合，使 `profile use` 切换
# 场景包时不会静默清掉这些手动激活的 skill；`deactivate` 会把对应 id
# 移出这份名单。文件不存在时一律视为空，不是错误。
resolve_manual_list_file() {
  printf '%s\n' "$SKILL_LIBRARY_ROOT/state/manual.list"
}

read_manual_ids() {
  local f
  f="$(resolve_manual_list_file)"
  [ -f "$f" ] || return 0
  sed '/^[[:space:]]*$/d; /^[[:space:]]*#/d' "$f" | LC_ALL=C sort -u
}

manual_list_add() {
  local id="$1" f dir tmp
  f="$(resolve_manual_list_file)"
  dir="$(dirname "$f")"
  mkdir -p "$dir" || return 1
  tmp="$(mktemp "$dir/.manual.list.XXXXXX")" || return 1
  { read_manual_ids; printf '%s\n' "$id"; } | LC_ALL=C sort -u > "$tmp"
  atomic_replace "$tmp" "$f"
}

manual_list_remove() {
  local id="$1" f dir tmp
  f="$(resolve_manual_list_file)"
  [ -f "$f" ] || return 0
  dir="$(dirname "$f")"
  tmp="$(mktemp "$dir/.manual.list.XXXXXX")" || return 1
  awk -v id="$id" '$0 != id' "$f" > "$tmp"
  atomic_replace "$tmp" "$f"
}

profile_ids() {
  local name="$1" profile
  profile="$PROFILE_DIR/$name"
  [ -f "$PROFILE_DIR/core" ] || return 1
  [ -f "$profile" ] || return 1
  {
    sed '/^[[:space:]]*$/d; /^[[:space:]]*#/d' "$PROFILE_DIR/core"
    [ "$name" = "core" ] || sed '/^[[:space:]]*$/d; /^[[:space:]]*#/d' "$profile"
    read_manual_ids
  } | LC_ALL=C sort -u
}

profile_contains_id() {
  local desired_file="$1" id="$2"
  grep -F -x "$id" "$desired_file" >/dev/null
}

replace_profile_links() {
  local destination_dir="$1" profile_name="$2" apply="$3" desired_file prune_file id entry relative_path target link safe_destination
  local prune_count prune_summary profiles_for_id
  safe_destination="$(safe_link_directory "$destination_dir" 2>/dev/null || true)"
  [ -n "$safe_destination" ] || {
    printf '[跳过] 目标路径含软链 %s\n' "$destination_dir"
    return 0
  }
  desired_file="$(mktemp "${TMPDIR:-/tmp}/skillctl-profile.XXXXXX")" || return 1
  prune_file="$(mktemp "${TMPDIR:-/tmp}/skillctl-profile-prune.XXXXXX")" || { rm -f "$desired_file"; return 1; }
  trap 'rm -f "$desired_file" "$prune_file"' RETURN
  profile_ids "$profile_name" > "$desired_file" || {
    printf '场景包不存在: %s\n' "$profile_name" >&2
    return 1
  }

  : > "$prune_file"
  prune_count=0
  prune_summary=""
  if [ -d "$safe_destination" ] && [ ! -L "$safe_destination" ]; then
    for link in "$safe_destination"/* "$safe_destination"/.[!.]* "$safe_destination"/..?*; do
      [ -L "$link" ] || continue
      id="$(basename "$link")"
      profile_contains_id "$desired_file" "$id" && continue
      entry="$(catalog_entry "$id")"
      [ -n "$entry" ] || continue
      relative_path="${entry%%"$(printf '	')"*}"
      target="$(physical_skill_target "$relative_path" 2>/dev/null || true)"
      [ -n "$target" ] || continue
      printf '%s\n' "$id" >> "$prune_file"
      profiles_for_id="$(collect_profiles_for_id "$id")"
      [ -n "$profiles_for_id" ] || profiles_for_id="未知来源"
      prune_count=$((prune_count + 1))
      if [ -n "$prune_summary" ]; then
        prune_summary="${prune_summary}, ${id}（${profiles_for_id}）"
      else
        prune_summary="${id}（${profiles_for_id}）"
      fi
    done
  fi

  if [ "$prune_count" -gt 0 ]; then
    printf '将停用 %s 个（不在 %s∪core∪手动激活列表内的现有成员）：%s\n' "$prune_count" "$profile_name" "$prune_summary"
  fi

  while IFS= read -r id; do
    [ -n "$id" ] || continue
    deactivate_id "$safe_destination" "$id" "$apply"
  done < "$prune_file"

  while IFS= read -r id; do
    [ -n "$id" ] || continue
    apply_link_for_id "$safe_destination" "$id" "$apply"
  done < "$desired_file"
  rm -f "$desired_file" "$prune_file"
  trap - RETURN
}

require_project_directory() {
  local project="$1"
  case "$project" in
    /*) ;;
    *)
      printf '项目路径必须是已存在的绝对目录\n' >&2
      return 1
      ;;
  esac
  real_dir "$project" || {
    printf '项目路径必须是已存在的绝对目录\n' >&2
    return 1
  }
}

normalize_query() {
  printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | LC_ALL=C tr '[:upper:]' '[:lower:]'
}

list_catalog() {
  awk -F '\t' 'NF == 8 { print $3 "\t" $1 "\t" $8 }' "$CATALOG_FILE" | \
    LC_ALL=C sort -t "$(printf '\t')" -k1,1 -k2,2
}

search_catalog() {
  local query
  query="$(normalize_query "$1")"
  awk -F '\t' -v query="$query" '
    function normalize(value) {
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      return tolower(value)
    }
    NF == 8 {
      id = normalize($1)
      display = normalize($3)
      aliases = normalize($4)
      triggers = normalize($6)
      description = normalize($8)
      if (index(id, query) || index(display, query) || index(aliases, query) || index(triggers, query) || index(description, query)) {
        print $3 "\t" $1 "\t" $8
      }
    }
  ' "$CATALOG_FILE" | LC_ALL=C sort -t "$(printf '\t')" -k1,1 -k2,2
}

route_candidates() {
  local query output_length line_length line score id display description tab candidate_count
  query="$(normalize_query "$1")"
  output_length=0
  candidate_count=0
  tab="$(printf '\t')"

  awk -F '\t' -v query="$query" '
    function normalize(value) {
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      return tolower(value)
    }
    function exact_in_csv(values, wanted, parts, count, index_value, item) {
      count = split(values, parts, ",")
      for (index_value = 1; index_value <= count; index_value++) {
        item = normalize(parts[index_value])
        if (item != "" && item == wanted) return 1
      }
      return 0
    }
    function contains_in_csv(values, wanted, parts, count, index_value, item) {
      count = split(values, parts, ",")
      for (index_value = 1; index_value <= count; index_value++) {
        item = normalize(parts[index_value])
        if (item != "" && index(wanted, item)) return 1
      }
      return 0
    }
    function trigger_score(values, wanted, parts, count, index_value, item, total) {
      total = 0
      count = split(values, parts, ",")
      for (index_value = 1; index_value <= count; index_value++) {
        item = normalize(parts[index_value])
        if (item != "" && index(wanted, item)) total += 20
      }
      return total
    }
    function exclusion_score(values, wanted, parts, count, index_value, item, total) {
      total = 0
      count = split(values, parts, ",")
      for (index_value = 1; index_value <= count; index_value++) {
        item = normalize(parts[index_value])
        if (item != "" && index(wanted, item)) total -= 80
      }
      return total
    }
    NF == 8 {
      id = normalize($1)
      display = normalize($3)
      aliases = normalize($4)
      category = normalize($5)
      triggers = $6
      excludes = $7
      if (query == "") next

      exact_name = (query == id || query == display)
      exact_alias = exact_in_csv(aliases, query)
      if (category == "system" && !exact_name && !exact_alias) next

      if (exact_name) score = 100
      else if (exact_alias) score = 95
      else {
        score = 0
        if (index(query, display) || contains_in_csv(aliases, query)) score += 60
        score += trigger_score(triggers, query)
        score += exclusion_score(excludes, query)
      }

      if (score >= 20) print score "\t" $1 "\t" $3 "\t" $8
    }
  ' "$CATALOG_FILE" | LC_ALL=C sort -t "$(printf '\t')" -k1,1nr -k2,2 | \
    while IFS="$(printf '\t')" read -r score id display description; do
      line="${score}${tab}${id}${tab}${display}${tab}${description}"
      line_length="$(printf '%s\n' "$line" | wc -m | tr -d ' ')"
      if [ $((output_length + line_length)) -gt 1200 ]; then
        continue
      fi
      printf '%s\n' "$line"
      output_length=$((output_length + line_length))
      candidate_count=$((candidate_count + 1))
      [ "$candidate_count" -lt 3 ] || exit 0
    done
}

expected_target() {
  local relative_path target_dir target_name
  relative_path="$1"
  target_dir="$(dirname "$SKILL_LIBRARY_ROOT/$relative_path")"
  target_name="$(basename "$SKILL_LIBRARY_ROOT/$relative_path")"
  [ -d "$target_dir" ] || return 1
  (cd "$target_dir" && printf '%s/%s\n' "$(pwd -P)" "$target_name")
}

link_status() {
  local link="$1" relative_path="$2" expected destination safe_destination standard_target
  if [ -L "$link" ]; then
    expected="$(expected_target "$relative_path" 2>/dev/null || true)"
    destination="$(dirname "$link")"
    safe_destination="$(safe_link_directory "$destination" 2>/dev/null || true)"
    if [ -n "$expected" ] && [ -n "$safe_destination" ]; then
      standard_target="$(relative_link_target "$safe_destination" "$expected")"
    else
      standard_target=""
    fi
    if [ -n "$standard_target" ] && managed_link_matches "$link" "$expected" "$standard_target"; then
      printf '已激活\n'
    else
      printf '外部软链冲突\n'
    fi
  elif [ -e "$link" ]; then
    printf '真实目录冲突\n'
  else
    printf '\n'
  fi
}

stored_status() {
  local relative_path="$1"
  if [ -d "$SKILL_LIBRARY_ROOT/$relative_path" ]; then
    printf '仓库中\n'
  else
    printf '缺失\n'
  fi
}

print_status() {
  local id relative_path display status project_status
  while IFS="$(printf '\t')" read -r id relative_path display _aliases _category _triggers _excludes _description; do
    [ -n "$id" ] || continue
    status="$(link_status "$GLOBAL_SKILLS_DIR/$id" "$relative_path")"
    [ -n "$status" ] || status="$(stored_status "$relative_path")"
    printf '全局\t%s\t%s\t%s\n' "$status" "$display" "$id"

    project_status="$(link_status "$PROJECT_SKILLS_DIR/$id" "$relative_path")"
    if [ -n "$project_status" ]; then
      printf '当前项目\t%s\t%s\t%s\n' "$project_status" "$display" "$id"
    fi
  done < "$CATALOG_FILE"
}

catalog_sha256() {
  shasum -a 256 "$CATALOG_FILE" | awk '{ print $1 }'
}

valid_gate_timestamp() {
  local evaluated_at="$1" evaluated_epoch current_epoch roundtrip
  evaluated_epoch="$(LC_ALL=C date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$evaluated_at" '+%s' 2>/dev/null)" || return 1
  roundtrip="$(LC_ALL=C date -u -r "$evaluated_epoch" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null)" || return 1
  [ "$roundtrip" = "$evaluated_at" ] || return 1
  current_epoch="$(date -u '+%s')"
  [ "$evaluated_epoch" -le "$current_epoch" ] || return 1
  [ $((current_epoch - evaluated_epoch)) -le 2592000 ]
}

valid_gate_metric() {
  local value="$1"
  [[ "$value" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 1
  decimal_at_least "$value" "0" && decimal_at_most "$value" "1"
}

decimal_compare() {
  local left="$1" right="$2" left_integer right_integer left_fraction right_fraction index left_digit right_digit
  left_integer="${left%%.*}"
  right_integer="${right%%.*}"
  left_fraction=""
  right_fraction=""
  case "$left" in *.*) left_fraction="${left#*.}" ;; esac
  case "$right" in *.*) right_fraction="${right#*.}" ;; esac

  while [ "${#left_integer}" -gt 1 ] && [ "${left_integer#0}" != "$left_integer" ]; do
    left_integer="${left_integer#0}"
  done
  while [ "${#right_integer}" -gt 1 ] && [ "${right_integer#0}" != "$right_integer" ]; do
    right_integer="${right_integer#0}"
  done
  while [ -n "$left_fraction" ] && [ "${left_fraction%0}" != "$left_fraction" ]; do
    left_fraction="${left_fraction%0}"
  done
  while [ -n "$right_fraction" ] && [ "${right_fraction%0}" != "$right_fraction" ]; do
    right_fraction="${right_fraction%0}"
  done

  if [ "${#left_integer}" -lt "${#right_integer}" ]; then return 1; fi
  if [ "${#left_integer}" -gt "${#right_integer}" ]; then return 2; fi
  if [[ "$left_integer" < "$right_integer" ]]; then return 1; fi
  if [[ "$left_integer" > "$right_integer" ]]; then return 2; fi

  index=0
  while [ "$index" -lt "${#left_fraction}" ] || [ "$index" -lt "${#right_fraction}" ]; do
    left_digit=0
    right_digit=0
    [ "$index" -ge "${#left_fraction}" ] || left_digit="${left_fraction:$index:1}"
    [ "$index" -ge "${#right_fraction}" ] || right_digit="${right_fraction:$index:1}"
    if [ "$left_digit" -lt "$right_digit" ]; then return 1; fi
    if [ "$left_digit" -gt "$right_digit" ]; then return 2; fi
    index=$((index + 1))
  done
  return 0
}

decimal_at_least() {
  local result
  if decimal_compare "$1" "$2"; then
    return 0
  else
    result=$?
  fi
  [ "$result" -eq 2 ]
}

decimal_at_most() {
  local result
  if decimal_compare "$1" "$2"; then
    return 0
  else
    result=$?
  fi
  [ "$result" -eq 1 ]
}

gate_metrics_enable_auto_route() {
  local top1="$1" top3="$2" ambiguous_false_select="$3"
  valid_gate_metric "$top1" && valid_gate_metric "$top3" && valid_gate_metric "$ambiguous_false_select" || return 1
  decimal_at_least "$top1" "0.90" && decimal_at_least "$top3" "0.98" && decimal_at_most "$ambiguous_false_select" "0.05"
}

print_route_status() {
  local gate_file stored_hash evaluated_at top1 top3 ambiguous_false_select auto_route current_hash
  gate_file="$SKILL_LIBRARY_ROOT/state/router-gate.tsv"

  if [ ! -f "$gate_file" ]; then
    printf '自动选择未启用\n'
    return 0
  fi

  if ! awk -F '\t' 'NR == 1 { if (NF != 6) exit 1; next } { exit 1 } END { if (NR != 1) exit 1 }' "$gate_file"; then
    printf '自动选择未启用\n'
    return 0
  fi
  IFS="$(printf '\t')" read -r stored_hash evaluated_at top1 top3 ambiguous_false_select auto_route < "$gate_file" || true
  current_hash="$(catalog_sha256)"
  if [ -n "$stored_hash" ] && [ -n "$evaluated_at" ] && [ -n "$top1" ] && [ -n "$top3" ] && [ -n "$ambiguous_false_select" ] && \
    [ "$stored_hash" = "$current_hash" ] && [ "$auto_route" = "enabled" ] && valid_gate_timestamp "$evaluated_at" && \
    gate_metrics_enable_auto_route "$top1" "$top3" "$ambiguous_false_select"; then
    printf '自动选择已启用\n'
  else
    printf '自动选择未启用\n'
  fi
}

path_is_ancestor() {
  local ancestor="$1" descendant="$2"
  [ "$ancestor" = "$descendant" ] && return 0
  case "$descendant" in
    "$ancestor"/*) return 0 ;;
  esac
  return 1
}

resolve_aliases_file() {
  printf '%s\n' "${SKILL_ALIASES:-$PACKAGE_ROOT/config/aliases.tsv}"
}

rebuild_catalog_or_warn() {
  local build_script aliases_file
  build_script="$SCRIPT_DIR/build-catalog.sh"
  aliases_file="$(resolve_aliases_file)"
  [ -f "$build_script" ] || return 0
  if ! SKILL_LIBRARY_ROOT="$SKILL_LIBRARY_ROOT" SKILL_ALIASES="$aliases_file" /bin/bash "$build_script" --apply >/dev/null 2>&1; then
    printf '警告：目录未能刷新，仍使用之前的 catalog.tsv\n' >&2
  fi
}

write_alias_row() {
  local aliases_file="$1" id="$2" display_name="$3" alias_extra="$4" tmp
  tmp="$(mktemp "$(dirname "$aliases_file")/.aliases.tsv.XXXXXX")" || return 1
  awk -F '\t' -v id="$id" -v display="$display_name" -v extra="$alias_extra" '
    BEGIN { OFS = "\t" }
    $0 ~ /^#/ || NF == 0 { print; next }
    $1 == id {
      found = 1
      if (display != "") $2 = display
      if (extra != "") { if ($3 != "") $3 = $3 "," extra; else $3 = extra }
      print
      next
    }
    { print }
    END {
      if (!found) {
        new_display = (display != "" ? display : id)
        printf "%s\t%s\t%s\t%s\t%s\t%s\n", id, new_display, extra, "imported", "", ""
      }
    }
  ' "$aliases_file" > "$tmp"
  atomic_replace "$tmp" "$aliases_file"
}

# 跟 write_alias_row 同一套 mktemp+过滤+atomic_replace 写法，反过来把这个
# id 的行整条删掉（而不是清空某几列）——之前 delete 流程没调用这个（因为
# 它压根不存在），导致 aliases.tsv 里的行永远不会因为 skill 被删除而消失，
# 换机器 clone 下来会带着一堆指向不存在目录的死记录。
remove_alias_row() {
  local aliases_file="$1" id="$2" tmp
  [ -f "$aliases_file" ] || return 0
  tmp="$(mktemp "$(dirname "$aliases_file")/.aliases.tsv.XXXXXX")" || return 1
  awk -F '\t' -v id="$id" '$0 ~ /^#/ || NF == 0 || $1 != id { print }' "$aliases_file" > "$tmp"
  atomic_replace "$tmp" "$aliases_file"
}

collect_profiles_for_id() {
  local id="$1" file result=""
  for file in "$PROFILE_DIR"/*; do
    [ -f "$file" ] || continue
    grep -F -x "$id" "$file" >/dev/null 2>&1 || continue
    if [ -n "$result" ]; then result="$result,$(basename "$file")"; else result="$(basename "$file")"; fi
  done
  printf '%s\n' "$result"
}

# doctor 的检查结果计数器，由 doctor_report() 累加，cmd_doctor() 在开始时重置。
DOCTOR_OK=0
DOCTOR_WARN=0
DOCTOR_FAIL=0

# lint 的检查结果计数器，由 lint_report() 累加，cmd_lint() 在开始时重置。
LINT_OK=0
LINT_WARN=0
LINT_FAIL=0

# 用 Finder 的"移到废纸篓"语义删除一个路径：可反悔，不是 rm -rf。跟
# dashboard-server.py 的 move_to_trash 是同一个策略（Finder 走不通就退回
# 直接挪进 ~/.Trash），这里是 CLI 自己要用的 bash 版本——import --replace
# 覆盖旧版本、skillctl delete 都靠这一个共用实现，不再各写一份。
# 路径先转义反斜杠和双引号再拼进 AppleScript 字符串——目前所有调用点传进
# 来的都是仓库内已校验过的 slug 路径，不会真的踩到，但转义本身几乎零成本，
# 不依赖"以后所有调用点都保证输入干净"这个假设。
trash_path() {
  local path="$1" dest escaped
  [ -e "$path" ] || return 0
  escaped="$(printf '%s' "$path" | sed 's/\\/\\\\/g; s/"/\\"/g')"
  if command -v osascript >/dev/null 2>&1 && \
     osascript -e "tell application \"Finder\" to delete (POSIX file \"$escaped\" as alias)" >/dev/null 2>&1; then
    return 0
  fi
  dest="$HOME/.Trash/$(basename "$path").$(date +%H%M%S)"
  mv "$path" "$dest"
}

# 覆盖式导入：新内容先落到 staging 目录、用哈希验证完整无误，验证通过才
# 动旧目录（挪进废纸篓）、再把 staging 换到位——安全窗口来自"先备好验证过
# 的新内容再删旧的"这个顺序本身，不需要仓库内部再单独留一份归档备份。
# staging 阶段失败的话旧目录完全没被碰过，直接原样保留。
import_copy_into_warehouse() {
  local real_source="$1" id="$2" staging_dir source_hash copied_hash target_dir
  target_dir="$SKILL_LIBRARY_ROOT/skills/$id"
  staging_dir="$SKILL_LIBRARY_ROOT/skills/.staging-$id"
  mkdir -p "$SKILL_LIBRARY_ROOT/skills" 2>/dev/null || true
  if ! mkdir "$staging_dir" 2>/dev/null; then
    return 1
  fi
  if ! /usr/bin/ditto "$real_source" "$staging_dir/$id" 2>/dev/null; then
    rm -rf "$staging_dir"
    return 1
  fi
  source_hash="$(directory_content_hash "$real_source")" || { rm -rf "$staging_dir"; return 1; }
  copied_hash="$(directory_content_hash "$staging_dir/$id" 2>/dev/null || true)"
  if [ "$source_hash" != "$copied_hash" ]; then
    rm -rf "$staging_dir"
    return 1
  fi
  if [ -e "$target_dir" ]; then
    if ! trash_path "$target_dir"; then
      rm -rf "$staging_dir"
      printf '旧版本移入废纸篓失败，新版本已验证但未落地：%s\n' "$staging_dir/$id" >&2
      return 1
    fi
  fi
  if ! mv "$staging_dir/$id" "$target_dir"; then
    rm -rf "$staging_dir"
    printf '新版本落地失败，旧版本已经在废纸篓，请从废纸篓手动找回：%s\n' "$id" >&2
    return 1
  fi
  rmdir "$staging_dir" 2>/dev/null || true
  return 0
}

cmd_import() {
  local source display_name="" alias_extra="" activate="no" replace="no" apply="no"
  [ "$#" -ge 1 ] || { usage >&2; return 2; }
  source="$1"
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --display-name)
        [ "$#" -ge 2 ] || { usage >&2; return 2; }
        display_name="$2"
        shift 2
        ;;
      --alias)
        [ "$#" -ge 2 ] || { usage >&2; return 2; }
        if [ -n "$alias_extra" ]; then alias_extra="$alias_extra,$2"; else alias_extra="$2"; fi
        shift 2
        ;;
      --activate) activate="yes"; shift ;;
      --replace) replace="yes"; shift ;;
      --apply) apply="yes"; shift ;;
      *) usage >&2; return 2 ;;
    esac
  done

  case "$source" in
    /*) ;;
    *) printf '来源必须是已存在的绝对目录\n' >&2; return 2 ;;
  esac
  local real_source
  real_source="$(real_dir "$source" 2>/dev/null || true)"
  [ -n "$real_source" ] || { printf '来源必须是已存在的绝对目录\n' >&2; return 2; }

  local library_real
  library_real="$(real_dir "$SKILL_LIBRARY_ROOT" 2>/dev/null || true)"
  if [ -n "$library_real" ]; then
    if path_is_ancestor "$library_real" "$real_source"; then
      printf '来源不能位于仓库内部：%s\n' "$real_source" >&2
      return 1
    fi
    if path_is_ancestor "$real_source" "$library_real"; then
      printf '来源是仓库的祖先目录，拒绝递归导入：%s\n' "$real_source" >&2
      return 1
    fi
  fi

  [ -f "$real_source/SKILL.md" ] || { printf '来源缺少 SKILL.md：%s\n' "$real_source" >&2; return 1; }
  local id
  id="$(skill_declared_name "$real_source" 2>/dev/null || true)"
  valid_skill_name "$id" || { printf '来源 SKILL.md 缺少合法 name 字段\n' >&2; return 1; }

  local aliases_file existing_display
  aliases_file="$(resolve_aliases_file)"
  [ -f "$aliases_file" ] || { printf '中文别名配置不存在：%s\n' "$aliases_file" >&2; return 1; }
  existing_display="$(awk -F '\t' -v id="$id" '$1 == id { print $2; exit }' "$aliases_file")"
  local display_defaulted="no"
  if [ -z "$existing_display" ] && [ -z "$display_name" ]; then
    display_name="$id"
    display_defaulted="yes"
  fi

  local source_hash target_dir mode target_hash
  source_hash="$(directory_content_hash "$real_source")" || { printf '无法读取来源内容\n' >&2; return 1; }
  target_dir="$SKILL_LIBRARY_ROOT/skills/$id"
  mode="new"
  if real_dir "$target_dir" >/dev/null 2>&1; then
    target_hash="$(directory_content_hash "$target_dir" 2>/dev/null || true)"
    if [ -n "$target_hash" ] && [ "$target_hash" = "$source_hash" ]; then
      printf '[已存在] %s 内容相同，无需变更\n' "$id"
      # 内容没变不代表"什么都不用做"——用户传了 --activate 就是想要这个
      # skill 处于激活状态，这里以前直接 return 0，--activate 被悄悄吞
      # 掉，连预演提示都没有，看着像是命令生效了实际什么也没发生。跟下面
      # "有实际改动"那条路径保持一致：预演模式给提示，--apply 才真的激活。
      if [ "$activate" = "yes" ]; then
        if [ "$apply" != "yes" ]; then
          printf '[预演] 导入后激活 %s\n' "$id"
        else
          APPLY_LINK_STATUS="skipped"
          apply_link_for_id "$GLOBAL_SKILLS_DIR" "$id" "yes"
          if [ "$APPLY_LINK_STATUS" = "managed" ]; then
            manual_list_add "$id"
          fi
          auto_rebuild_dashboard
          printf '[已激活] %s\n' "$id"
        fi
      fi
      return 0
    fi
    if [ "$replace" != "yes" ]; then
      printf '仓库已存在内容不同的 %s，如需替换请使用 --replace --apply\n' "$id" >&2
      return 1
    fi
    mode="replace"
  elif [ -e "$target_dir" ]; then
    printf '仓库路径被占用且不是可识别的 Skill 目录：%s\n' "$target_dir" >&2
    return 1
  fi

  if [ "$apply" != "yes" ]; then
    if [ "$mode" = "replace" ]; then
      printf '[预演] 替换 %s（旧版本移入废纸篓）-> skills/%s\n' "$id" "$id"
    else
      printf '[预演] 导入 %s -> skills/%s\n' "$id" "$id"
    fi
    if [ "$display_defaulted" = "yes" ]; then
      printf '[预演] 未提供 --display-name，display_name 默认等于 id：%s\n' "$id"
    elif [ -n "$display_name" ] || [ -n "$alias_extra" ]; then
      printf '[预演] 写入别名 %s\n' "$id"
    fi
    [ "$activate" = "yes" ] && printf '[预演] 导入后激活 %s\n' "$id"
    return 0
  fi

  # import_copy_into_warehouse 自己负责"新内容先验证、旧目录再挪进废纸
  # 篓"这个顺序——staging 失败旧目录完全不受影响，不需要在这里再单独处理
  # replace 分支。也正因为整个替换只是原地换掉 skills/$id 目录本身的内容、
  # 从没碰过任何软链，替换前已经激活的话替换后自动还是激活状态，不需要
  # 额外传 --activate 才能保住。
  if ! import_copy_into_warehouse "$real_source" "$id"; then
    printf '导入失败\n' >&2
    return 1
  fi

  local row_exists
  row_exists="$(awk -F '\t' -v id="$id" '$1 == id { f = 1 } END { print f + 0 }' "$aliases_file")"
  if [ "$row_exists" = "0" ] || [ -n "$display_name" ] || [ -n "$alias_extra" ]; then
    write_alias_row "$aliases_file" "$id" "$display_name" "$alias_extra"
  fi

  rebuild_catalog_or_warn

  if [ "$activate" = "yes" ]; then
    # 跟独立的 activate 命令保持一致：只建软链不够，还得登记进
    # manual.list，不然 doctor 会报"有受管软链但未登记"——这里之前漏了
    # 这一步（历史遗留，import --activate 一直是这样），import-github
    # 走到这条路径时复现了出来，顺手一起补上。
    APPLY_LINK_STATUS="skipped"
    apply_link_for_id "$GLOBAL_SKILLS_DIR" "$id" "yes"
    if [ "$APPLY_LINK_STATUS" = "managed" ]; then
      manual_list_add "$id"
    fi
    auto_rebuild_dashboard
  fi
  printf '[已导入] %s -> skills/%s\n' "$id" "$id"
}

# 从 GitHub 导入：clone 到临时目录、定位 SKILL.md、给一眼内容预览，然后
# 复用 cmd_import 本身那一整套安全检查（哈希去重、--replace 先把旧版本
# 挪进废纸篓、别名保留、--activate、catalog 重建），不重新实现一遍。
#
# 安全边界：
# - 只认 https://github.com/<owner>/<repo> 或其 /tree/<ref>/<子路径> 形式，
#   owner/repo 只允许 GitHub 合法字符集，且整个 clone URL 恒以 https://
#   字面量开头——即使字符集里混进 -，拼出来的 URL 也不可能被 git 当成选项。
# - --path 子路径拒绝绝对路径和 ..，并在 clone 完成后用 path_is_ancestor
#   验证解析结果确实还在克隆目录内部，防止跳出去读克隆目录外的文件。
# - GIT_TERMINAL_PROMPT=0：私有仓库或仓库不存在时 git 会直接失败退出，
#   不会挂在交互式认证提示上卡住整个命令。
# - 临时克隆目录在每个 return 路径前手动清理（这台机器的系统 /bin/bash
#   3.2 上 trap ... RETURN 实测不可靠，预演分支没触发过，会在 $TMPDIR
#   底下攒垃圾——不用 trap，显式、可验证）。
#
# 真正的 clone 动作在 clone_github_repo 里，这里只做 URL 解析和调用；
# check-updates 批量检查时也会直接调这个 helper，跳开 cmd_import_github
# 自己的预览/落地逻辑，避免同一个仓库因为登记了好几个 skill 就被重复
# clone 好几遍。
clone_github_repo() {
  local owner="$1" repo="$2" ref="$3" subpath="$4"
  command -v git >/dev/null 2>&1 || { printf '需要 git，未检测到\n' >&2; return 1; }

  local tmpdir
  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/skillctl-github-clone.XXXXXX")" || {
    printf '创建临时目录失败\n' >&2
    return 1
  }

  local clone_url="https://github.com/$owner/$repo.git" ref_note=""
  [ -n "$ref" ] && ref_note="（ref: ${ref}）"
  printf '克隆 %s%s ...\n' "$clone_url" "$ref_note" >&2
  # 这几个 clone 永远是匿名拉公开仓库，不该也不需要任何凭证——但如果用户
  # 全局 git 配置里给 github.com 配了 credential.helper（很常见，比如
  # `gh auth git-credential`），git 匿名 clone 时仍然会先尝试调用它。那
  # 个 helper 进程本身在这台机器上、由这个后台服务的环境变量/PATH/无 TTY
  # 启动时可能失败或者行为跟交互式终端不一样，进而把整个 clone 拖挂——
  # 加 -c credential.helper=（空值）显式关掉，绕开这一整类问题，不用去
  # 猜 gh 到底为什么在这个环境里出问题。
  local -a clone_args=(-c credential.helper= clone --depth 1 --quiet)
  [ -n "$ref" ] && clone_args+=(--branch "$ref")
  clone_args+=("$clone_url" "$tmpdir/repo")
  # git 自己的报错之前直接扔进 /dev/null 了，只留一句"检查仓库是否存
  # 在、ref 是否正确、网络是否可达"的通用猜测——真出问题时看不出到底是
  # 哪一种，排查全靠猜。现在接一份 git 的真实 stderr，带在错误里一起报。
  local git_err
  git_err="$(mktemp "${TMPDIR:-/tmp}/skillctl-git-err.XXXXXX")" || {
    printf '创建临时文件失败\n' >&2
    rm -rf "$tmpdir"
    return 1
  }
  if ! GIT_TERMINAL_PROMPT=0 git "${clone_args[@]}" >/dev/null 2>"$git_err"; then
    local git_msg
    git_msg="$(tail -1 "$git_err" 2>/dev/null)"
    rm -f "$git_err"
    # GitHub 匿名 clone 一个不存在的仓库和一个私有仓库，服务端返回的都是
    # 401（不这样的话匿名请求就能靠"存在返回404/私有返回401"的差异来探测
    # 私有仓库是否存在，这是 GitHub 故意的行为）——git 因此会尝试要用户名
    # 密码，而 GIT_TERMINAL_PROMPT=0 又不让它弹交互式提示，于是永远是这
    # 句"could not read Username"，只讲清楚了"卡在要认证"这个机制细节，
    # 完全没告诉人真正该往哪个方向查。这种情况下 99% 都是拼错了 owner/
    # repo 或者仓库真不存在，比模糊的原始 git 报错有用得多，值得单独识别
    # 出来给一句人话提示。
    if printf '%s' "$git_msg" | grep -q 'could not read Username\|Authentication failed\|could not read Password'; then
      printf '克隆失败：%s（仓库不存在，或是私有仓库匿名访问不了——先确认 owner/repo 拼写没错。git 报错：%s）\n' "$clone_url" "$git_msg" >&2
    elif [ -n "$git_msg" ]; then
      printf '克隆失败：%s（git 报错：%s）\n' "$clone_url" "$git_msg" >&2
    else
      printf '克隆失败：%s（检查仓库是否存在、ref 是否正确、网络是否可达）\n' "$clone_url" >&2
    fi
    rm -rf "$tmpdir"
    return 1
  fi
  rm -f "$git_err"
  # 浅克隆的 .git 目录从没被用到过（不需要历史，只要工作区文件），留着
  # 会有两个真实后果：--path 留空导入仓库根目录时，.git 会被当成"内容"
  # 一起 ditto 进仓库（把整份 git 元数据永久拷进 skills/<id>/ 里）；即使
  # 有 --path，.git 也会被 directory_content_hash 算作根目录内容的一部
  # 分，而同一个仓库每次重新 clone 出来的 .git 内部结构本身就不是逐字
  # 节稳定的——check-updates 拿这类哈希做比对会不该报"有更新"时误报。
  # 提前删掉，克隆结果只剩纯工作区文件。
  rm -rf "$tmpdir/repo/.git"

  local repo_real resolved
  repo_real="$(real_dir "$tmpdir/repo" 2>/dev/null || true)"
  if [ -z "$repo_real" ]; then
    printf '克隆结果异常\n' >&2
    rm -rf "$tmpdir"
    return 1
  fi
  if [ -n "$subpath" ]; then
    resolved="$(real_dir "$repo_real/$subpath" 2>/dev/null || true)"
  else
    resolved="$repo_real"
  fi
  if [ -z "$resolved" ] || ! path_is_ancestor "$repo_real" "$resolved"; then
    printf '子路径不存在或越界：%s\n' "$subpath" >&2
    rm -rf "$tmpdir"
    return 1
  fi

  # 三行输出：tmpdir（调用方用完自己 rm -rf）、repo_real（仓库根目录，
  # 给"没找到 SKILL.md，猜是多 skill 仓库"那个提示用）、resolved（真正
  # 要用的目录）。不用 eval 或 nameref 往调用方变量里塞值——这台机器的
  # 系统 bash 3.2 也不支持 nameref，三行文本让调用方自己 sed 取，跟仓库
  # 里其它地方的风格一致。
  printf '%s\n%s\n%s\n' "$tmpdir" "$repo_real" "$resolved"
}

cmd_import_github() {
  [ "$#" -ge 1 ] || { usage >&2; return 2; }
  local url="$1"
  shift
  # 从浏览器地址栏/聊天窗口/文档编辑器复制的链接经常带两类肉眼看不出的
  # 问题字符：(a) 零宽空格、NBSP、孤立 \r 这类纯噪音，删掉就好；(b) 排版
  # 软件自动替换出来的"长得像 ASCII 但不是"的标点——最典型的是不断行连
  # 字符 U+2011（跟连字符 - 肉眼完全一样），一段 owner-repo 里的连字符被
  # 换成它之后，如果直接把非 ASCII 字节整段删掉（第一版就是这么写的），
  # "vercel‑labs" 会被删成完全不同的 "vercellabs"——git clone 一个根本不
  # 存在的仓库，报错还让人摸不着头脑。所以必须先把这类"形似 ASCII"的标
  # 点换回真正的 ASCII 字符，再删剩下真正的不可见噪音，顺序不能反。
  url="$(printf '%s' "$url" | sed \
    -e 's/‐/-/g; s/‑/-/g; s/‒/-/g; s/–/-/g; s/—/-/g; s/−/-/g' \
    -e 's/／/\//g; s/：/:/g; s/．/./g; s/－/-/g; s/＿/_/g')"
  # tr 的字节范围语法依赖 C locale，不加 LC_ALL=C 时系统 UTF-8 locale 会
  # 把多字节字符当一个整体处理，range 匹配会静默失效（实测过，不是保险
  # 起见）；这一步只删纯噪音，上面 sed 那一步已经把有意义的标点转换完了。
  url="$(printf '%s' "$url" | LC_ALL=C tr -d '\000-\037\177-\377')"
  local path_arg="" ref_arg=""
  local -a rest=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --path)
        [ "$#" -ge 2 ] || { usage >&2; return 2; }
        path_arg="$2"
        shift 2
        ;;
      --ref)
        [ "$#" -ge 2 ] || { usage >&2; return 2; }
        ref_arg="$2"
        shift 2
        ;;
      --display-name|--alias)
        [ "$#" -ge 2 ] || { usage >&2; return 2; }
        rest+=("$1" "$2")
        shift 2
        ;;
      --activate|--replace|--apply)
        rest+=("$1")
        shift
        ;;
      *) usage >&2; return 2 ;;
    esac
  done

  local owner repo tree_ref="" tree_path=""
  if [[ "$url" =~ ^https://github\.com/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)(\.git)?/?$ ]]; then
    owner="${BASH_REMATCH[1]}"
    repo="${BASH_REMATCH[2]}"
  elif [[ "$url" =~ ^https://github\.com/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)/tree/([^/]+)/(.+)$ ]]; then
    owner="${BASH_REMATCH[1]}"
    repo="${BASH_REMATCH[2]}"
    tree_ref="${BASH_REMATCH[3]}"
    tree_path="${BASH_REMATCH[4]}"
  else
    printf '只支持 https://github.com/<owner>/<repo> 或 https://github.com/<owner>/<repo>/tree/<ref>/<子路径> 这两种链接：%s\n' "$url" >&2
    return 2
  fi

  local ref="${ref_arg:-$tree_ref}"
  local subpath="${path_arg:-$tree_path}"
  case "$subpath" in
    /*|*..*)
      printf -- '--path 不能是绝对路径也不能包含 ..：%s\n' "$subpath" >&2
      return 2
      ;;
  esac

  # 这台机器的系统 /bin/bash（3.2）测过 trap ... RETURN 在这个函数的调用
  # 形状下不可靠（预演分支实测没触发，会在 $TMPDIR 底下攒垃圾）——仓库
  # 里其它地方本来也都不用 trap，克隆本身和这里一样改成每个 return 前
  # 手动清一次，显式、可验证，不依赖这个老 bash 版本的行为。
  local clone_out tmpdir repo_real resolved
  clone_out="$(clone_github_repo "$owner" "$repo" "$ref" "$subpath")" || return 1
  tmpdir="$(printf '%s\n' "$clone_out" | sed -n '1p')"
  repo_real="$(printf '%s\n' "$clone_out" | sed -n '2p')"
  resolved="$(printf '%s\n' "$clone_out" | sed -n '3p')"

  if [ ! -f "$resolved/SKILL.md" ]; then
    printf '%s 下没有 SKILL.md。' "${subpath:-仓库根目录}" >&2
    # 旧版本只认"skills/<name>/SKILL.md"这一层扁平结构，写死去看
    # "$repo_real/skills"下面的一级子目录。像 mattpocock/skills 这种按
    # 分类多套一层的仓库（skills/<分类>/<name>/SKILL.md）会踩坑：选了
    # "skills/productivity"这个分类目录本身（它自己没有 SKILL.md），
    # 于是又去看写死的"$repo_real/skills"，原样把同一份分类列表再报一
    # 遍——用户看到的是自己刚试过的路径又出现在"建议"里，绕不出去。改成
    # 直接从当前尝试的 resolved 往下找真正挂着 SKILL.md 的目录（最多找 4
    # 层，够覆盖"扁平"和"带一层分类"两种常见结构），建议永远是"在你已经
    # 走到的地方往下一层"，不会绕回原地。
    local skill_dirs
    skill_dirs="$(find "$resolved" -mindepth 1 -maxdepth 4 -iname 'SKILL.md' -exec dirname {} \; 2>/dev/null | sort)"
    if [ -n "$skill_dirs" ]; then
      printf '这个仓库像是多 Skill 仓库，试试 --path <子目录>，比如：\n' >&2
      printf '%s\n' "$skill_dirs" | while IFS= read -r d; do
        printf '    --path %s\n' "${d#$repo_real/}" >&2
      done
    else
      printf '\n' >&2
    fi
    rm -rf "$tmpdir"
    return 1
  fi

  # "预览"不能只说"这是只读的"，得让人看到具体要引入什么内容——声明的
  # name/description，以及带没带可执行脚本——再决定要不要继续。
  local decl_name decl_desc script_files clone_url ref_note
  decl_name="$(skill_declared_name "$resolved" 2>/dev/null || true)"
  decl_desc="$(skill_description "$resolved" 2>/dev/null || true)"
  script_files="$(find "$resolved" -type f \( -name '*.sh' -o -name '*.js' -o -name '*.mjs' -o -name '*.cjs' -o -name '*.py' -o -name '*.rb' \) 2>/dev/null || true)"
  clone_url="https://github.com/$owner/$repo.git"
  ref_note=""
  [ -n "$ref" ] && ref_note="（ref: ${ref}）"
  printf -- '--- 来源预览 ---\n'
  printf '仓库：%s%s\n' "$clone_url" "$ref_note"
  printf '子路径：%s\n' "${subpath:-（仓库根目录）}"
  printf '声明 name：%s\n' "${decl_name:-（缺失）}"
  printf '声明 description：%s\n' "${decl_desc:-（缺失）}"
  if [ -n "$script_files" ]; then
    printf '带可执行脚本（%s 个），确认前建议过一眼：\n' "$(printf '%s\n' "$script_files" | grep -c .)"
    printf '%s\n' "$script_files" | sed "s|^$resolved/||; s/^/    /"
  else
    printf '不含可执行脚本\n'
  fi
  printf -- '----------------\n'

  # 空数组直接展开 "${rest[@]}" 在这台机器的系统 /bin/bash（3.2，macOS
  # 自带的老版本，跟 Homebrew 装的新版 bash 不是同一个）在 set -u 下会报
  # unbound variable——先判个数再决定要不要展开，绕开这个老 bash 的坑。
  # 这里还接住 cmd_import 的退出码（而不是让 set -e 直接终止），是为了
  # 保证不管 cmd_import 成功与否，$tmpdir 都会被清理，再把原始退出码传
  # 出去，调用方看到的失败/成功语义跟直接调用 cmd_import 完全一致。
  local rc=0
  if [ "${#rest[@]}" -gt 0 ]; then
    cmd_import "$resolved" "${rest[@]}" || rc=$?
  else
    cmd_import "$resolved" || rc=$?
  fi

  # 真正落地成功（带了 --apply 且 cmd_import 没报错）才登记来源，预演
  # 分支不登记——登记的"基准哈希"必须是仓库里实际存在的内容，不能是还
  # 没写进去的预演结果。登记失败（比如 state/ 目录权限问题）不影响这次
  # 导入本身已经成功这件事，只 best-effort，不改变返回码。
  local applied="no" r
  if [ "$rc" -eq 0 ] && [ "${#rest[@]}" -gt 0 ]; then
    for r in "${rest[@]}"; do
      [ "$r" = "--apply" ] && applied="yes"
    done
  fi
  if [ "$applied" = "yes" ]; then
    record_provenance "$decl_name" "https://github.com/$owner/$repo" "$subpath" "$ref" || true
  fi

  rm -rf "$tmpdir"
  return "$rc"
}

resolve_provenance_file() {
  printf '%s\n' "$SKILL_LIBRARY_ROOT/state/provenance.tsv"
}

# 来源登记：id \t url \t path \t ref \t imported_hash \t imported_at，供
# check-updates 判断"本地是否还是登记时的样子"。跟 write_alias_row 一样
# 的 upsert 写法：先把这个 id 的旧行滤掉，再把新行接上去，整体走
# mktemp+mv 原子替换。
write_provenance_row() {
  local file="$1" id="$2" url="$3" path="$4" ref="$5" hash="$6" at="$7" tmp
  mkdir -p "$(dirname "$file")" 2>/dev/null || true
  tmp="$(mktemp "$(dirname "$file")/.provenance.tsv.XXXXXX")" || return 1
  if [ -f "$file" ]; then
    awk -F '\t' -v id="$id" '$1 != id' "$file" > "$tmp"
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$url" "$path" "$ref" "$hash" "$at" >> "$tmp"
  mv "$tmp" "$file"
}

provenance_row() {
  local file="$1" id="$2"
  [ -f "$file" ] || return 0
  awk -F '\t' -v id="$id" '$1 == id { print; exit }' "$file"
}

# 记一次来源：把 id 当前的仓库内容哈希当成"基准版本"——check-updates 靠
# 对比这个哈希和当前哈希是否一致，判断"本地还是干净的、能跟上游比"还是
# "已经被手动改过、不能贸然覆盖"。import-github 落地成功后自动调用；
# track-source 给早于这套机制就存在的 skill 补登记时也调用它，只是基准
# 版本变成"补登记那一刻的当前内容"，不是真正的原始导入版本——没法追溯
# 更早的版本，只能退而求其次从补登记这一刻开始追踪。
record_provenance() {
  local id="$1" url="$2" path="$3" ref="$4" file hash at
  file="$(resolve_provenance_file)"
  hash="$(directory_content_hash "$SKILL_LIBRARY_ROOT/skills/$id" 2>/dev/null || true)"
  [ -n "$hash" ] || return 1
  at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  write_provenance_row "$file" "$id" "$url" "$path" "$ref" "$hash" "$at"
}

cmd_track_source() {
  local id="$1" url="$2" path="$3" ref="$4" apply="$5"
  local path_note="" ref_note=""
  real_dir "$SKILL_LIBRARY_ROOT/skills/$id" >/dev/null 2>&1 || {
    printf '仓库中没有 %s，无法登记来源；不知道 id 就先 skillctl status\n' "$id" >&2
    return 1
  }
  case "$url" in
    https://github.com/*) ;;
    *) printf 'url 必须是 https://github.com/... 开头：%s\n' "$url" >&2; return 1 ;;
  esac
  case "$path" in
    /*|*..*) printf -- '--path 不能是绝对路径也不能包含 ..：%s\n' "$path" >&2; return 1 ;;
  esac
  [ -n "$path" ] && path_note="（子路径 ${path}）"
  [ -n "$ref" ] && ref_note="（ref: ${ref}）"

  # 登记前先跟上游比一眼：如果这时候本地内容已经跟上游不一样，说明在
  # 补登记之前它就已经被改过了——不是"干净、当下等于某个上游版本"的起
  # 点。这种情况下 check-updates 以后会一直报"有更新"，但那只表示"内容
  # 不同"，不代表"落后于上游、可以放心覆盖"（本地可能反而是领先/更丰富
  # 的一方，直接 --replace 会把这些改动冲掉）。这个提醒必须在登记这一刻
  # 就说清楚，不能指望以后 check-updates 的措辞自己讲明白这个区别。
  local -a peek_args=("$url")
  [ -n "$path" ] && peek_args+=(--path "$path")
  [ -n "$ref" ] && peek_args+=(--ref "$ref")
  local peek_out
  peek_out="$(cmd_import_github "${peek_args[@]}" 2>&1)" || true
  if printf '%s' "$peek_out" | grep -q '如需替换请使用'; then
    printf '注意：%s 现在的内容已经跟上游不一样了（很可能是登记前就手动改过）。登记之后 check-updates 会一直显示"有更新"，但那只表示"内容不同"，不代表"落后于上游、可以放心覆盖"——千万别看到"有更新"就直接 --replace，会把本地的修改冲掉，想更新前请先自己对比差异。\n' "$id"
  fi

  if [ "$apply" != "yes" ]; then
    printf '[预演] 登记 %s -> %s%s%s（基准版本 = 当前仓库内容）\n' "$id" "$url" "$path_note" "$ref_note"
    return 0
  fi
  record_provenance "$id" "$url" "$path" "$ref" || { printf '登记失败：%s\n' "$id" >&2; return 1; }
  printf '[已登记] %s -> %s%s%s\n' "$id" "$url" "$path_note" "$ref_note"
}

# 对每个登记过来源的 id：先比对当前内容哈希跟登记时的基准哈希，不一致
# 说明本地已经改过，直接跳过、不联网查上游（避免"能不能覆盖"判断出错，
# 也省一次不必要的 clone）；一致的话才去跟上游比，直接复用
# cmd_import_github 自己的预演输出（它本来就会判断"内容相同"还是"不
# 同"），不重新写一遍 clone+哈希比对的逻辑。
cmd_check_updates_one() {
  local id="$1" file row url path ref imported_hash current_hash out
  file="$(resolve_provenance_file)"
  row="$(provenance_row "$file" "$id")"
  if [ -z "$row" ]; then
    printf '%s\t未登记来源（用 skillctl track-source 补登记，或本来就不是从 GitHub 导入的）\n' "$id"
    return 0
  fi
  # 不用 IFS=tab + read 拆字段——bash 的 read 把 tab 当成"IFS 空白字符"，
  # 连续分隔符（也就是这行中间 ref 为空时的两个相邻 tab）会被合并成一个，
  # 导致空字段被跳过、后面的字段全部错位一格（实测过：ref 从没传过的
  # 正常情况下会直接错位）。cut 按位置取字段不做这种合并，空字段该是空
  # 还是空。
  url="$(printf '%s' "$row" | cut -f2)"
  path="$(printf '%s' "$row" | cut -f3)"
  ref="$(printf '%s' "$row" | cut -f4)"
  imported_hash="$(printf '%s' "$row" | cut -f5)"
  current_hash="$(directory_content_hash "$SKILL_LIBRARY_ROOT/skills/$id" 2>/dev/null || true)"
  if [ -z "$current_hash" ]; then
    printf '%s\t仓库中读不到这个 id，跳过\n' "$id"
    return 0
  fi
  if [ "$current_hash" != "$imported_hash" ]; then
    printf '%s\t本地内容已改动（跟登记时不一致），跳过上游对比，不会误判覆盖\n' "$id"
    return 0
  fi

  local -a check_args=("$url")
  [ -n "$path" ] && check_args+=(--path "$path")
  [ -n "$ref" ] && check_args+=(--ref "$ref")
  # cmd_import_github 预演到"内容不同"时会 return 1（这是它正常的、故意
  # 的行为——检查是否有更新本来就期待经常撞到这个分支），但在 set -e 下，
  # 裸的 var="$(失败的命令)" 赋值会让整个脚本直接退出，不会走到下面这些
  # grep 分支——用 || true 接住，只关心它打印了什么，不关心退出码本身。
  out="$(cmd_import_github "${check_args[@]}" 2>&1)" || true
  if printf '%s' "$out" | grep -q '内容相同，无需变更'; then
    printf '%s\t已是最新\n' "$id"
  elif printf '%s' "$out" | grep -q '如需替换请使用'; then
    printf '%s\t有更新，可用 skillctl import-github %s' "$id" "$url"
    [ -n "$path" ] && printf ' --path %s' "$path"
    [ -n "$ref" ] && printf ' --ref %s' "$ref"
    printf ' --replace --apply 更新\n'
  else
    printf '%s\t检查失败：%s\n' "$id" "$(printf '%s' "$out" | tail -1)"
  fi
}

# 组内的 id 共享同一次 clone_github_repo（同一个 url+ref 已经克隆过了），
# 从这份克隆里各自定位自己的 --path 子目录、跟仓库里现在的内容比哈希。
# clean_file 是 cmd_check_updates 传来的"本地未改动、待联网核实"名单，
# 4 列：id / url / ref / path。
check_updates_group() {
  local group_url="$1" group_ref="$2" clean_file="$3"
  local owner repo
  if [[ "$group_url" =~ ^https://github\.com/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)(\.git)?/?$ ]]; then
    owner="${BASH_REMATCH[1]}"
    repo="${BASH_REMATCH[2]}"
  else
    # 理论上不会发生（url 落地前都在 track-source/import-github 里校验
    # 过），但真出现的话把这一组每个 id 都标成检查失败，不能让整个
    # check-updates 崩掉。
    awk -F '\t' -v u="$group_url" -v r="$group_ref" '$2 == u && $3 == r { printf "%s\t检查失败：登记的 url 格式不对：%s\n", $1, u }' "$clean_file"
    return 0
  fi

  # clone_github_repo 的错误原因是打到 stderr 的（"需要 git，未检测到"、
  # "克隆失败：...检查仓库是否存在/ref是否正确/网络是否可达"等），之前
  # 这里直接吞掉、统一报"克隆上游仓库失败"——诊断不出到底是什么原因，
  # 排查全靠猜。现在单独接一份 stderr，失败时把最后一行原样带出来。
  local clone_out clone_err clone_rc=0 tmpdir repo_real
  clone_err="$(mktemp "${TMPDIR:-/tmp}/skillctl-check-updates-err.XXXXXX")" || {
    awk -F '\t' -v u="$group_url" -v r="$group_ref" '$2 == u && $3 == r { printf "%s\t检查失败：创建临时文件失败\n", $1 }' "$clean_file"
    return 0
  }
  clone_out="$(clone_github_repo "$owner" "$repo" "$group_ref" "" 2>"$clone_err")" || clone_rc=$?
  if [ "$clone_rc" -ne 0 ]; then
    local msg
    msg="$(tail -1 "$clone_err" 2>/dev/null)"
    rm -f "$clone_err"
    [ -n "$msg" ] || msg="克隆失败（原因不明）"
    awk -F '\t' -v u="$group_url" -v r="$group_ref" -v m="$msg" '$2 == u && $3 == r { printf "%s\t检查失败：%s\n", $1, m }' "$clean_file"
    return 0
  fi
  rm -f "$clone_err"
  tmpdir="$(printf '%s\n' "$clone_out" | sed -n '1p')"
  repo_real="$(printf '%s\n' "$clone_out" | sed -n '2p')"

  local line each_id path upstream_dir upstream_hash current_hash
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    each_id="$(printf '%s' "$line" | cut -f1)"
    path="$(printf '%s' "$line" | cut -f4)"
    if [ -n "$path" ]; then
      upstream_dir="$(real_dir "$repo_real/$path" 2>/dev/null || true)"
    else
      upstream_dir="$repo_real"
    fi
    if [ -z "$upstream_dir" ] || ! path_is_ancestor "$repo_real" "$upstream_dir"; then
      printf '%s\t检查失败：子路径不存在或越界\n' "$each_id"
      continue
    fi
    upstream_hash="$(directory_content_hash "$upstream_dir" 2>/dev/null || true)"
    current_hash="$(directory_content_hash "$SKILL_LIBRARY_ROOT/skills/$each_id" 2>/dev/null || true)"
    if [ -z "$upstream_hash" ] || [ -z "$current_hash" ]; then
      printf '%s\t检查失败：读取内容哈希失败\n' "$each_id"
    elif [ "$upstream_hash" = "$current_hash" ]; then
      printf '%s\t已是最新\n' "$each_id"
    else
      printf '%s\t有更新，可用 skillctl import-github %s' "$each_id" "$group_url"
      [ -n "$path" ] && printf ' --path %s' "$path"
      [ -n "$group_ref" ] && printf ' --ref %s' "$group_ref"
      printf ' --replace --apply 更新\n'
    fi
  done < <(awk -F '\t' -v u="$group_url" -v r="$group_ref" '$2 == u && $3 == r' "$clean_file")

  rm -rf "$tmpdir"
}

cmd_check_updates() {
  local id="$1" file
  file="$(resolve_provenance_file)"
  if [ -n "$id" ]; then
    cmd_check_updates_one "$id"
    return 0
  fi
  if [ ! -f "$file" ]; then
    printf '还没有任何 skill 登记过来源（import-github 导入后自动登记，或用 skillctl track-source 给已有的补登记）\n'
    return 0
  fi

  # 先把每个 id 是否本地已改动判断完（纯本地读取，不联网，很快）；干净
  # 的才值得真的联网核实，写进一个临时文件按 (url, ref) 分组——同一个
  # 仓库/ref 登记了好几个 skill 时（比如整套 Superpowers 14 个都指向
  # obra/superpowers）以前是每个 id 各自 clone 一遍，15 个里 14 个撞同一
  # 个仓库时实测要 50+ 秒，长到面板那次点击直接超时/连接被打断；分组后
  # 同一个仓库只 clone 一次。
  local clean_file each_id row url path ref imported_hash current_hash
  clean_file="$(mktemp "${TMPDIR:-/tmp}/skillctl-check-updates.XXXXXX")" || {
    printf '创建临时文件失败\n' >&2
    return 1
  }
  : > "$clean_file"
  while IFS= read -r each_id; do
    [ -n "$each_id" ] || continue
    row="$(provenance_row "$file" "$each_id")"
    url="$(printf '%s' "$row" | cut -f2)"
    path="$(printf '%s' "$row" | cut -f3)"
    ref="$(printf '%s' "$row" | cut -f4)"
    imported_hash="$(printf '%s' "$row" | cut -f5)"
    current_hash="$(directory_content_hash "$SKILL_LIBRARY_ROOT/skills/$each_id" 2>/dev/null || true)"
    if [ -z "$current_hash" ]; then
      printf '%s\t仓库中读不到这个 id，跳过\n' "$each_id"
    elif [ "$current_hash" != "$imported_hash" ]; then
      printf '%s\t本地内容已改动（跟登记时不一致），跳过上游对比，不会误判覆盖\n' "$each_id"
    else
      printf '%s\t%s\t%s\t%s\n' "$each_id" "$url" "$ref" "$path" >> "$clean_file"
    fi
  done < <(awk -F '\t' '{ print $1 }' "$file")

  if [ ! -s "$clean_file" ]; then
    rm -f "$clean_file"
    return 0
  fi

  local group_key group_url group_ref
  while IFS= read -r group_key; do
    [ -n "$group_key" ] || continue
    group_url="$(printf '%s' "$group_key" | cut -f1)"
    group_ref="$(printf '%s' "$group_key" | cut -f2)"
    check_updates_group "$group_url" "$group_ref" "$clean_file"
  done < <(awk -F '\t' '{ print $2 "\t" $3 }' "$clean_file" | sort -u)

  rm -f "$clean_file"
}

# 只读操作，不需要 --apply：只是把仓库里已有内容原样拷一份到仓库外，不改
# 仓库、不改 catalog、不改软链状态。导出天然是"干净"的——skillctl 自己的
# 登记信息（catalog.tsv 的行、state/ 下的记录）本来就存在
# 仓库层面，从不写进 Skill 自己的目录里，所以只要 ditto 这个目录本身，输出
# 就已经只含 SKILL.md 和内容文件，不用额外过滤。
cmd_export() {
  local id="$1" output="$2" entry relative_path target destination source_hash copied_hash parent

  entry="$(catalog_entry "$id")"
  [ -n "$entry" ] || { printf '未登记 Skill：%s；不知道 id 就先 skillctl status 或 skillctl search <关键词>\n' "$id" >&2; return 1; }
  relative_path="${entry%%"$(printf '\t')"*}"
  target="$(physical_skill_target "$relative_path" 2>/dev/null || true)"
  [ -n "$target" ] || { printf '仓库缺少 Skill 内容：%s\n' "$id" >&2; return 1; }

  if [ -n "$output" ]; then
    case "$output" in
      /*) ;;
      *) printf -- '--output 必须是绝对路径\n' >&2; return 2 ;;
    esac
    destination="$output"
  else
    destination="$HOME/Desktop/skill-export-$id"
  fi

  if [ -e "$destination" ] || [ -L "$destination" ]; then
    printf '目标已存在：%s；换个路径或先清理\n' "$destination" >&2
    return 1
  fi

  parent="$(dirname "$destination")"
  mkdir -p "$parent" 2>/dev/null || { printf '无法创建目标所在目录：%s\n' "$parent" >&2; return 1; }

  if ! /usr/bin/ditto "$target" "$destination" 2>/dev/null; then
    rm -rf "$destination"
    printf '导出失败：%s\n' "$id" >&2
    return 1
  fi
  source_hash="$(directory_content_hash "$target")" || { rm -rf "$destination"; printf '无法读取仓库内容\n' >&2; return 1; }
  copied_hash="$(directory_content_hash "$destination" 2>/dev/null || true)"
  if [ "$source_hash" != "$copied_hash" ]; then
    rm -rf "$destination"
    printf '导出内容校验失败，已清理不完整的输出：%s\n' "$destination" >&2
    return 1
  fi

  printf '[已导出] %s -> %s\n' "$id" "$destination"
  printf '只含 SKILL.md 与内容目录，不带仓库登记信息，可直接上传到 claude.ai 账户库或分享给他人\n'
}

resolve_adapters_file() {
  printf '%s\n' "${SKILL_ADAPTERS:-$PACKAGE_ROOT/config/adapters/tools.tsv}"
}

expand_tilde() {
  # 不依赖 shell 的 tilde 展开（那对带引号的字符串本来就不生效）——这里是
  # 显式用参数展开去掉字面 ~ 前缀，再手动拼上 $HOME，是故意的写法。
  # shellcheck disable=SC2088
  case "$1" in
    "~"|"~/"*) printf '%s\n' "$HOME${1#\~}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

adapter_row() {
  local id="$1" adapters_file="$2"
  awk -F '\t' -v id="$id" '$0 !~ /^#/ && $1 == id { print; exit }' "$adapters_file"
}

# bash's `read` treats tab as "IFS whitespace" and collapses consecutive
# delimiters even when IFS is set to tab alone, silently dropping empty
# fields and shifting everything after them (macOS ships bash 3.2, whose
# `read` also fails to split on control-character IFS like $'\001', so a
# control char doesn't fix it either). Swap tabs for `;`, a plain character
# outside the whitespace class, so empty fields (e.g. no cli_command)
# survive. None of the adapter columns are expected to contain `;`.
tsv_to_read_safe() {
  tr '\t' ';' <<< "$1"
}

detect_status_for_row() {
  local mode="$1" global_dir="$2" cli_command="$3" app_name="$4" resolved_dir
  if { [ -n "$app_name" ] && [ -d "$APPLICATIONS_DIR/$app_name.app" ]; } || \
     { [ -n "$cli_command" ] && command -v "$cli_command" >/dev/null 2>&1; }; then
    printf '已检测\n'
    return 0
  fi
  # native adapters all share the same global skills directory, so its mere
  # existence is not tool-specific evidence; only link adapters get the
  # "residual directory" fallback.
  if [ "$mode" = "link" ]; then
    resolved_dir="$(expand_tilde "$global_dir")"
    if [ -d "$resolved_dir" ] && [ ! -L "$resolved_dir" ]; then
      printf '可能是残留目录\n'
      return 0
    fi
  fi
  printf '未检测到\n'
}

# 从人类可读的平台名生成一个能当 adapter id 用的 slug：转小写、非字母
# 数字的整段换成一个连字符、去掉首尾连字符。跟 valid_skill_name 用的
# 字符集一致（小写字母数字+连字符），自定义平台的 id 和 skill id 走
# 同一套约定，不会在别处校验时被拒。
slugify_tool_id() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

# 注册一个用户自己填的自定义平台：只要平台名 + 技能目录路径，写一行到
# tools.tsv 里，剩下的 detect/connect/disconnect/面板展示全都是数据驱动
# 的，不用为"自定义"这个概念单独写一套逻辑。verification 字段故意写死
# 成字面量 "unverified"（cmd_tools_connect 已有的、之前一直没被触发过
# 的那个 --allow-unverified 门槛，正好用在这——skillctl 不认识这个用户
# 自己填的平台，第一次连接强制要求显式确认）。
cmd_add_custom_tool() {
  local display_name="$1" dir_input="$2" apply="$3"
  local id adapters_file global_dir project_dir

  [ -n "$display_name" ] || { printf '平台名称不能为空\n' >&2; return 1; }
  [ -n "$dir_input" ] || { printf '技能目录路径不能为空\n' >&2; return 1; }

  id="$(slugify_tool_id "$display_name")"
  valid_skill_name "$id" || {
    printf '平台名称转成 id 后不合法（%s）：至少要包含一个字母或数字\n' "$id" >&2
    return 1
  }

  adapters_file="$(resolve_adapters_file)"
  [ -f "$adapters_file" ] || { printf '软件适配器配置不存在：%s\n' "$adapters_file" >&2; return 1; }
  if [ -n "$(adapter_row "$id" "$adapters_file")" ]; then
    printf '已存在同 id 的平台：%s（换个名字，或者这个平台可能已经注册过了）\n' "$id" >&2
    return 1
  fi

  case "$dir_input" in
    "~"|"~/"*|/*) global_dir="$dir_input" ;;
    *) printf '技能目录路径必须是绝对路径或 ~ 开头：%s\n' "$dir_input" >&2; return 1 ;;
  esac
  case "$global_dir" in
    "~/"*) project_dir="${global_dir#\~/}" ;;
    *) project_dir="" ;;
  esac

  if [ "$apply" != "yes" ]; then
    printf '[预演] 注册自定义平台 %s（id: %s）-> %s\n' "$display_name" "$id" "$global_dir"
    return 0
  fi

  printf '%s\t%s\tlink\t%s\t%s\t\t%s\tunverified\n' "$id" "$display_name" "$global_dir" "$project_dir" "$display_name" >> "$adapters_file"
  printf '[已注册] %s -> %s（首次连接需要 skillctl tools connect %s --allow-unverified --apply）\n' "$display_name" "$global_dir" "$id"
}

cmd_tools_detect() {
  local adapters_file id display mode global_dir _project_dir cli_command app_name verification status mode_label
  adapters_file="$(resolve_adapters_file)"
  [ -f "$adapters_file" ] || { printf '软件适配器配置不存在：%s\n' "$adapters_file" >&2; return 1; }
  while IFS=';' read -r id display mode global_dir _project_dir cli_command app_name verification; do
    [ -n "$id" ] || continue
    case "$id" in \#*) continue ;; esac
    status="$(detect_status_for_row "$mode" "$global_dir" "$cli_command" "$app_name")"
    if [ "$mode" = "native" ]; then mode_label="原生"; else mode_label="软链"; fi
    printf '%s\t%s\t%s\n' "$id" "$status" "$mode_label"
  done < <(tr '\t' ';' < "$adapters_file")
}

cmd_tools_connect() {
  local id="$1" apply="$2" allow_unverified="$3" prune="$4" adapters_file row
  local _id display mode global_dir _project_dir cli_command app_name verification resolved_dir sync_script
  local -a sync_args

  adapters_file="$(resolve_adapters_file)"
  [ -f "$adapters_file" ] || { printf '软件适配器配置不存在：%s\n' "$adapters_file" >&2; return 1; }
  row="$(adapter_row "$id" "$adapters_file")"
  [ -n "$row" ] || { printf '未知适配器：%s\n' "$id" >&2; return 1; }
  IFS=';' read -r _id display mode global_dir _project_dir cli_command app_name verification <<< "$(tsv_to_read_safe "$row")"

  if [ "$mode" = "native" ]; then
    printf '[信息] %s 为原生模式，自动共享 %s，无需连接\n' "$display" "$GLOBAL_SKILLS_DIR"
    return 0
  fi

  if [ "$verification" = "unverified" ] && [ "$allow_unverified" != "yes" ]; then
    printf '%s 尚未验证，如需连接请加上 --allow-unverified\n' "$display" >&2
    return 1
  fi

  resolved_dir="$(expand_tilde "$global_dir")"
  sync_script="$SCRIPT_DIR/sync-skills.sh"
  [ -f "$sync_script" ] || { printf '同步脚本不存在：%s\n' "$sync_script" >&2; return 1; }

  sync_args=(--target "$resolved_dir")
  [ "$prune" = "yes" ] && sync_args+=(--prune)
  [ "$apply" = "yes" ] && sync_args+=(--apply)

  SKILLS_SRC="$GLOBAL_SKILLS_DIR" SKILL_ADAPTERS="$adapters_file" /bin/bash "$sync_script" "${sync_args[@]}"
}

cmd_tools_disconnect() {
  local id="$1" apply="$2" adapters_file row
  local _id display mode global_dir _project_dir cli_command app_name verification resolved_dir sync_script

  adapters_file="$(resolve_adapters_file)"
  [ -f "$adapters_file" ] || { printf '软件适配器配置不存在：%s\n' "$adapters_file" >&2; return 1; }
  row="$(adapter_row "$id" "$adapters_file")"
  [ -n "$row" ] || { printf '未知适配器：%s\n' "$id" >&2; return 1; }
  IFS=';' read -r _id display mode global_dir _project_dir cli_command app_name verification <<< "$(tsv_to_read_safe "$row")"

  if [ "$mode" = "native" ]; then
    printf '[信息] %s 为原生模式，没有独立的受管软链需要断开\n' "$display"
    return 0
  fi

  resolved_dir="$(expand_tilde "$global_dir")"
  sync_script="$SCRIPT_DIR/sync-skills.sh"
  [ -f "$sync_script" ] || { printf '同步脚本不存在：%s\n' "$sync_script" >&2; return 1; }

  if [ "$apply" = "yes" ]; then
    SKILLS_SRC="$GLOBAL_SKILLS_DIR" SKILL_ADAPTERS="$adapters_file" /bin/bash "$sync_script" --target "$resolved_dir" --disconnect --apply
  else
    SKILLS_SRC="$GLOBAL_SKILLS_DIR" SKILL_ADAPTERS="$adapters_file" /bin/bash "$sync_script" --target "$resolved_dir" --disconnect
  fi
}

cmd_dashboard_build() {
  local apply="$1" build_script
  build_script="$SCRIPT_DIR/build-dashboard.sh"
  [ -f "$build_script" ] || { printf '面板生成脚本不存在：%s\n' "$build_script" >&2; return 1; }
  if [ "$apply" = "yes" ]; then
    /bin/bash "$build_script" --apply
  else
    /bin/bash "$build_script"
  fi
}

cmd_dashboard_open() {
  local html="$SKILL_LIBRARY_ROOT/dashboard/index.html"
  [ -f "$html" ] || { printf '面板尚未生成，请先运行 skillctl dashboard build --apply\n' >&2; return 1; }
  open "$html"
}

cmd_dashboard_serve() {
  local server_script="$SCRIPT_DIR/dashboard-server.py"
  [ -f "$server_script" ] || { printf '面板服务脚本不存在：%s\n' "$server_script" >&2; return 1; }
  command -v python3 >/dev/null 2>&1 || { printf '需要 python3，本机未找到\n' >&2; return 1; }
  SKILL_LIBRARY_ROOT="$SKILL_LIBRARY_ROOT" python3 "$server_script"
}

# 判断一个软链是否"归属仓库"：把软链一路解析到最终真实路径，只要落在
# $SKILL_LIBRARY_ROOT/skills 之下（不管中间经过几层——直接指向仓库，或者
# 先指向 GLOBAL_SKILLS_DIR 再由它指向仓库），就认定是 skillctl 建立的托管
# 软链。不认识的外部软链一律跳过，不动。
eject_link_is_repo_managed() {
  local link="$1" real repo_real
  [ -L "$link" ] || return 1
  real="$(cd "$link" 2>/dev/null && pwd -P)" || return 1
  repo_real="$(real_dir "$SKILL_LIBRARY_ROOT/skills" 2>/dev/null || true)"
  [ -n "$repo_real" ] || return 1
  path_is_ancestor "$repo_real" "$real"
}

# 先对所有目标目录做一次只读扫描，把"哪些软链归属仓库、当前分别指向哪个
# 真实路径"整体记录进一个 dir;name;real 三列的计划文件，再统一执行。
# 不能一边扫描一边就地物化：如果先把 GLOBAL_SKILLS_DIR 下的软链换成了真实
# 拷贝，紧接着再扫描某个工具自己目录下"经过 GLOBAL_SKILLS_DIR 转一手"的
# 软链时，它已经不再解析到仓库（因为链路中间那一段已经是真实目录了），会
# 被误判成"不归属仓库"而被跳过——用一份预先固定的计划文件从根源上避免这
# 种"先处理的目标影响后处理的目标判断结果"的顺序依赖。
eject_build_plan() {
  local plan_file="$1" dir link name real
  shift
  : > "$plan_file"
  for dir in "$@"; do
    for link in "$dir"/*; do
      [ -L "$link" ] || continue
      eject_link_is_repo_managed "$link" || continue
      name="$(basename "$link")"
      real="$(cd "$link" && pwd -P)"
      printf '%s;%s;%s\n' "$dir" "$name" "$real" >> "$plan_file"
    done
  done
}

# 按计划文件里属于某个目录的记录逐条执行（或预演）：apply 模式下 ditto 到
# 暂存名，确认拷贝成功后才原地把软链换成真实目录（跟 import_copy_into_
# warehouse 一样，只在拷贝确认成功后才动原软链，避免中间态）。
eject_physicalize_planned() {
  local dir="$1" apply="$2" plan_file="$3"
  local p_dir p_name p_real link tmp_parent tmp failed=0 count=0
  while IFS=';' read -r p_dir p_name p_real; do
    [ "$p_dir" = "$dir" ] || continue
    count=$((count + 1))
    link="$dir/$p_name"
    if [ "$apply" != "yes" ]; then
      printf '  [预演] 物化 %s（复制自 %s）\n' "$link" "$p_real"
      continue
    fi
    tmp_parent="$(mktemp -d "$dir/.eject-XXXXXX" 2>/dev/null)" || {
      printf '  [失败] 无法创建暂存目录，跳过：%s\n' "$link" >&2
      failed=1
      continue
    }
    tmp="$tmp_parent/$p_name"
    if ! /usr/bin/ditto "$p_real" "$tmp"; then
      printf '  [失败] 复制失败，保留原软链：%s\n' "$link" >&2
      rm -rf "$tmp_parent"
      failed=1
      continue
    fi
    rm -f "$link"
    mv "$tmp" "$link"
    rmdir "$tmp_parent" 2>/dev/null || true
    printf '  [已物化] %s\n' "$link"
  done < "$plan_file"
  [ "$count" -eq 0 ] && printf '  没有受管软链\n'
  [ "$failed" -eq 0 ]
}

cmd_eject() {
  local apply="$1" adapters_file id display mode global_dir _project_dir cli_command app_name verification
  local resolved_dir safe_dir safe_global target backup_root backup_name idx failed=0 plan_file
  local plan_count plan_dir_count
  local -a targets=() target_labels=()

  safe_global="$(safe_link_directory "$GLOBAL_SKILLS_DIR" 2>/dev/null || true)"
  if [ -n "$safe_global" ] && [ -d "$safe_global" ] && [ ! -L "$safe_global" ]; then
    targets+=("$safe_global")
    target_labels+=("${GLOBAL_SKILLS_DIR}（全局共享目录，原生工具直接读取这里）")
  fi

  adapters_file="$(resolve_adapters_file)"
  if [ -f "$adapters_file" ]; then
    while IFS=';' read -r id display mode global_dir _project_dir cli_command app_name verification; do
      [ -n "$id" ] || continue
      case "$id" in \#*) continue ;; esac
      [ "$mode" = "link" ] || continue
      resolved_dir="$(expand_tilde "$global_dir")"
      safe_dir="$(safe_link_directory "$resolved_dir" 2>/dev/null || true)"
      [ -n "$safe_dir" ] && [ -d "$safe_dir" ] && [ ! -L "$safe_dir" ] || continue
      targets+=("$safe_dir")
      target_labels+=("${display}（${id}）")
    done < <(tr '\t' ';' < "$adapters_file")
  fi

  if [ "${#targets[@]}" -eq 0 ]; then
    printf '没有发现受管软链目录，无需 eject\n'
    return 0
  fi

  plan_file="$(mktemp "${TMPDIR:-/tmp}/skillctl-eject-plan.XXXXXX")" || {
    printf '无法创建临时计划文件，eject 中止\n' >&2
    return 1
  }
  trap 'rm -f "$plan_file"' RETURN
  eject_build_plan "$plan_file" "${targets[@]}"

  if [ ! -s "$plan_file" ]; then
    printf '没有发现受管软链目录，无需 eject\n'
    return 0
  fi

  plan_count="$(wc -l < "$plan_file" | tr -d ' ')"
  plan_dir_count="$(awk -F ';' '{print $1}' "$plan_file" | LC_ALL=C sort -u | wc -l | tr -d ' ')"

  if [ "$apply" != "yes" ]; then
    printf '[预演] eject 将把 %s 条受管软链物化为独立真实拷贝，涉及 %s 个目录：\n' "$plan_count" "$plan_dir_count"
    printf '备份位置（示意路径，实际时间戳以 --apply 执行时为准）：%s/eject-backups/<时间戳>/\n\n' "$SKILL_LIBRARY_ROOT"
    idx=0
    for target in "${targets[@]}"; do
      printf '── %s\n' "${target_labels[$idx]}"
      eject_physicalize_planned "$target" "no" "$plan_file"
      printf '\n'
      idx=$((idx + 1))
    done
    printf '确认后运行：skillctl eject --apply\n'
    return 0
  fi

  backup_root="$SKILL_LIBRARY_ROOT/eject-backups/$(date -u '+%Y%m%d-%H%M%S')"
  mkdir -p "$backup_root" || { printf '备份目录创建失败，eject 中止\n' >&2; return 1; }
  idx=0
  for target in "${targets[@]}"; do
    idx=$((idx + 1))
    backup_name="$idx-$(basename "$target")"
    if ! /usr/bin/ditto "$target" "$backup_root/$backup_name"; then
      printf '备份失败：%s，eject 中止（此前已生成的部分备份见 %s）\n' "$target" "$backup_root" >&2
      return 1
    fi
  done
  printf '已备份将改动的目录到: %s\n\n' "$backup_root"

  printf '开始物化 %s 条受管软链，涉及 %s 个目录：\n\n' "$plan_count" "$plan_dir_count"
  idx=0
  for target in "${targets[@]}"; do
    printf '── %s\n' "${target_labels[$idx]}"
    eject_physicalize_planned "$target" "yes" "$plan_file" || failed=1
    printf '\n'
    idx=$((idx + 1))
  done

  if [ "$failed" -eq 1 ]; then
    printf '部分目录物化失败，改动前的备份见 %s，请人工核查后重试\n' "$backup_root" >&2
    return 1
  fi

  printf '已脱离 skillctl 管理，各工具目录现为独立副本，仓库目录 %s 可自行保留或删除\n' "$SKILL_LIBRARY_ROOT"
}

doctor_report() {
  local level="$1" message="$2" fix="${3:-}"
  case "$level" in
    ok)
      DOCTOR_OK=$((DOCTOR_OK + 1))
      printf '✅ %s\n' "$message"
      ;;
    warn)
      DOCTOR_WARN=$((DOCTOR_WARN + 1))
      printf '⚠️ %s\n' "$message"
      [ -z "$fix" ] || printf '   → %s\n' "$fix"
      ;;
    fail)
      DOCTOR_FAIL=$((DOCTOR_FAIL + 1))
      printf '❌ %s\n' "$message"
      [ -z "$fix" ] || printf '   → %s\n' "$fix"
      ;;
  esac
}

doctor_check_global_broken_links() {
  local link id
  [ -d "$GLOBAL_SKILLS_DIR" ] && [ ! -L "$GLOBAL_SKILLS_DIR" ] || return 0
  for link in "$GLOBAL_SKILLS_DIR"/*; do
    [ -L "$link" ] || continue
    [ -e "$link" ] && continue
    id="$(basename "$link")"
    doctor_report fail "断链：$GLOBAL_SKILLS_DIR/$id 指向的仓库内容不存在" \
      "人工确认该 Skill 是否已被手动移出仓库；确认后 rm \"$GLOBAL_SKILLS_DIR/$id\" 清理，或把内容放回仓库后 skillctl activate $id --apply 重新建链"
  done
  return 0
}

doctor_check_tool_broken_links() {
  local adapters_file id display mode global_dir _project_dir cli_command app_name verification resolved_dir link name
  adapters_file="$(resolve_adapters_file)"
  [ -f "$adapters_file" ] || return 0
  while IFS=';' read -r id display mode global_dir _project_dir cli_command app_name verification; do
    [ -n "$id" ] || continue
    case "$id" in \#*) continue ;; esac
    [ "$mode" = "link" ] || continue
    resolved_dir="$(expand_tilde "$global_dir")"
    [ -d "$resolved_dir" ] && [ ! -L "$resolved_dir" ] || continue
    for link in "$resolved_dir"/*; do
      [ -L "$link" ] || continue
      [ -e "$link" ] && continue
      name="$(basename "$link")"
      doctor_report fail "断链：${display}（${id}）下的 $name 指向不存在的目标" \
        "skillctl tools connect $id --prune --apply"
    done
  done < <(tr '\t' ';' < "$adapters_file")
  return 0
}

# 用 DOCTOR_FAIL 计数器前后差值判断这一组检查是否发现了问题，不依赖子函数
# 的返回码——这个项目已经在 deactivate 分支上因为裸 `&&` 影响退出码踩过一次
# 坑（见 CLAUDE.md），这里改用计数器差值从根源上绕开同类风险。
doctor_check_broken_links() {
  local before
  before="$DOCTOR_FAIL"
  doctor_check_global_broken_links
  doctor_check_tool_broken_links
  if [ "$DOCTOR_FAIL" = "$before" ]; then
    doctor_report ok "没有发现断链"
  fi
}

# 断链检查（doctor_check_broken_links）是"货架上的软链指向仓库里已经不存在
# 的内容"；这里反过来查两类"仓库根本不认识"的情况：
#   1. 货架上有真实目录（不是软链）——典型场景是直接让 AI 工具把新技能装到
#      ~/.agents/skills 或 ~/.claude/skills 这类原生扫描目录，而不是走
#      skillctl import。
#   2. 货架上有软链接，但指向的不是仓库（$SKILL_LIBRARY_ROOT/skills 之下），
#      而是外部某个目录——典型场景是接管 skillctl 之前手动建的裸链接，内容
#      看似"装好了"，实际上从没走过 import，仓库和面板都不知道它存在。
# 两种情况都只查一层，不递归；只认"目录里有 SKILL.md"的才算数，避免把货架
# 下面的杂散文件/临时目录也报进来。
doctor_check_shelf_orphans_dir() {
  local dir="$1" entry resolved id declared display
  [ -d "$dir" ] && [ ! -L "$dir" ] || return 0
  for entry in "$dir"/*; do
    if [ -L "$entry" ]; then
      [ -d "$entry" ] || continue
      resolved="$(cd "$entry" 2>/dev/null && pwd -P)" || continue
      case "$resolved" in
        "$SKILL_LIBRARY_ROOT"/skills/*) continue ;;
      esac
      [ -f "$resolved/SKILL.md" ] || continue
      declared="$(skill_declared_name "$resolved" 2>/dev/null || true)"
      id="$(basename "$entry")"
      if [ -n "$declared" ]; then
        [ -n "$(catalog_entry "$declared")" ] && continue
      else
        [ -n "$(catalog_entry "$id")" ] && continue
      fi
      display="${declared:-$id}"
      doctor_report warn "货架目录 $dir 下的 $display 是指向仓库之外的裸链接（-> ${resolved}），仓库和面板都不认识它" \
        "确认内容无误后 skillctl import \"$resolved\" --activate --apply 收编进仓库，再把这条裸链接换成 skillctl 建的软链"
      continue
    fi
    [ -d "$entry" ] || continue
    [ -f "$entry/SKILL.md" ] || continue
    declared="$(skill_declared_name "$entry" 2>/dev/null || true)"
    id="$(basename "$entry")"
    if [ -n "$declared" ]; then
      [ -n "$(catalog_entry "$declared")" ] && continue
    else
      [ -n "$(catalog_entry "$id")" ] && continue
    fi
    display="${declared:-$id}"
    doctor_report warn "货架目录 $dir 下的 $display 是真实目录，不是仓库管理的软链，仓库和面板都不认识它" \
      "确认内容无误后 skillctl import \"$entry\" --activate --apply 收编进仓库"
  done
  return 0
}

doctor_check_shelf_orphans() {
  local before seen adapters_file id display mode global_dir _project_dir _cli_command _app_name _verification resolved_dir
  before="$DOCTOR_WARN"

  doctor_check_shelf_orphans_dir "$GLOBAL_SKILLS_DIR"
  seen=",$GLOBAL_SKILLS_DIR,"

  adapters_file="$(resolve_adapters_file)"
  if [ -f "$adapters_file" ]; then
    while IFS=';' read -r id display mode global_dir _project_dir _cli_command _app_name _verification; do
      [ -n "$id" ] || continue
      case "$id" in \#*) continue ;; esac
      [ "$mode" = "link" ] || continue
      resolved_dir="$(expand_tilde "$global_dir")"
      case "$seen" in *",$resolved_dir,"*) continue ;; esac
      seen="$seen$resolved_dir,"
      doctor_check_shelf_orphans_dir "$resolved_dir"
    done < <(tr '\t' ';' < "$adapters_file")
  fi

  [ "$DOCTOR_WARN" = "$before" ] && doctor_report ok "货架上没有发现未收编进仓库的真实目录"
  return 0
}

doctor_check_tools() {
  local adapters_file id display mode global_dir _project_dir cli_command app_name verification status resolved_dir keyword candidates
  adapters_file="$(resolve_adapters_file)"
  [ -f "$adapters_file" ] || {
    doctor_report fail "软件适配器配置不存在：$adapters_file" "检查安装是否完整（config/adapters/tools.tsv 缺失）"
    return 0
  }
  while IFS=';' read -r id display mode global_dir _project_dir cli_command app_name verification; do
    [ -n "$id" ] || continue
    case "$id" in \#*) continue ;; esac
    status="$(detect_status_for_row "$mode" "$global_dir" "$cli_command" "$app_name")"
    case "$status" in
      已检测)
        doctor_report ok "${display}（${id}）已检测到"
        ;;
      可能是残留目录)
        resolved_dir="$(expand_tilde "$global_dir")"
        doctor_report warn "${display}（${id}）只发现残留的软链目录 ${resolved_dir}，工具本身可能已卸载或未运行过" \
          "仍在用就先运行一次该工具；确认不再使用可以 skillctl tools disconnect $id --apply 清理"
        ;;
      未检测到)
        candidates=""
        keyword="${id%%-*}"
        if [ -n "$app_name" ] && [ -d "$APPLICATIONS_DIR" ]; then
          # candidates 只用来拼一行诊断文字给人看，不会再按行/按词拆开处理，
          # 应用文件夹名里出现换行这种边缘情况顶多让这行提示变丑，不影响正确性。
          # shellcheck disable=SC2010
          candidates="$(ls -1 "$APPLICATIONS_DIR" 2>/dev/null | grep -i -- "$keyword" || true)"
        fi
        if [ -n "$candidates" ]; then
          doctor_report warn "${display}（${id}）按配置的 app_name「${app_name}」未检测到，但 /Applications 下发现疑似同类文件夹：$(printf '%s' "$candidates" | tr '\n' '、')" \
            "确认这就是 $display 之后，手动把 tools.tsv 里 $id 这行的 app_name 改成真实文件夹名"
        else
          doctor_report warn "${display}（${id}）未检测到" \
            "先安装/运行一次该工具；如果确认已安装但显示名不同，用 ls /Applications | grep -i $keyword 核实后修正 tools.tsv 里的 app_name"
        fi
        ;;
    esac
  done < <(tr '\t' ';' < "$adapters_file")
}

doctor_check_verification() {
  local adapters_file id display mode global_dir _project_dir cli_command app_name verification found=0
  adapters_file="$(resolve_adapters_file)"
  [ -f "$adapters_file" ] || return 0
  while IFS=';' read -r id display mode global_dir _project_dir cli_command app_name verification; do
    [ -n "$id" ] || continue
    case "$id" in \#*) continue ;; esac
    if [ "$verification" = "unverified" ]; then
      found=1
      doctor_report warn "${display}（${id}）的 verification 字段字面为 unverified，tools connect 会被拦截" \
        "确认已完成人工核实后加 --allow-unverified 执行 tools connect $id"
    fi
  done < <(tr '\t' ';' < "$adapters_file")
  [ "$found" -eq 1 ] || doctor_report ok "verification：当前没有适配器被标记为 unverified（此项检查是为将来新增适配器保留的，目前基本不会触发）"
}

doctor_check_manual_list() {
  local ids id entry relative_path status link id2 profiles found=0
  ids="$(read_manual_ids)"
  if [ -n "$ids" ]; then
    while IFS= read -r id; do
      [ -n "$id" ] || continue
      entry="$(catalog_entry "$id")"
      if [ -z "$entry" ]; then
        found=1
        doctor_report warn "manual.list 记录了未登记的 Skill：$id" \
          "确认是否还需要，若不需要手动从 $SKILL_LIBRARY_ROOT/state/manual.list 删除该行"
        continue
      fi
      relative_path="${entry%%"$(printf '	')"*}"
      status="$(link_status "$GLOBAL_SKILLS_DIR/$id" "$relative_path")"
      if [ "$status" != "已激活" ]; then
        found=1
        doctor_report warn "manual.list 记录了 ${id}，但 $GLOBAL_SKILLS_DIR 下没有对应的受管软链（当前状态：${status:-缺失}）" \
          "如仍需要：skillctl activate $id --apply 重建；如不再需要：skillctl deactivate $id --apply 会一并清理 manual.list 记录"
      fi
    done <<< "$ids"
  fi

  if [ -d "$GLOBAL_SKILLS_DIR" ] && [ ! -L "$GLOBAL_SKILLS_DIR" ]; then
    for link in "$GLOBAL_SKILLS_DIR"/*; do
      [ -L "$link" ] && [ -e "$link" ] || continue
      # 只关心归属仓库的软链——用户自己手动指到仓库以外内容的软链（比如
      # 直接建到别的目录）不归 skillctl 管，不该被建议 activate/deactivate。
      eject_link_is_repo_managed "$link" || continue
      id2="$(basename "$link")"
      printf '%s\n' "$ids" | grep -F -x "$id2" >/dev/null 2>&1 && continue
      profiles="$(collect_profiles_for_id "$id2")"
      [ -n "$profiles" ] && continue
      found=1
      doctor_report warn "$id2 在 $GLOBAL_SKILLS_DIR 下有受管软链，但既不属于任何场景包，也没记录在 manual.list 里" \
        "如需保留：skillctl activate $id2 --apply 补登记进 manual.list；如不需要：skillctl deactivate $id2 --apply"
    done
  fi

  [ "$found" -eq 1 ] || doctor_report ok "manual.list 与磁盘软链状态一致"
}

doctor_check_skill_files() {
  local dir id name desc found=0
  [ -d "$SKILL_LIBRARY_ROOT/skills" ] || {
    doctor_report warn "仓库 skills/ 目录不存在：$SKILL_LIBRARY_ROOT/skills" "确认 SKILL_LIBRARY_ROOT 是否正确：$SKILL_LIBRARY_ROOT"
    return 0
  }
  for dir in "$SKILL_LIBRARY_ROOT/skills"/*; do
    [ -d "$dir" ] && [ ! -L "$dir" ] || continue
    id="$(basename "$dir")"
